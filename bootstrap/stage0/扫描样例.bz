字节数组 读路径[260]
字节数组 写路径[260]
字节数组 源[64]
整数 暂存 = 0
整数 长度 = 0

函数 扫描数字(结束) {
整数 游标 = 0
当(游标 < 结束) {
如果(源[游标] < 48) { 返回 游标 }
如果(源[游标] > 57) { 返回 游标 }
游标 = 游标 + 1
}
返回 游标
}

如果(参数数量() != 2) { 返回 2 }
暂存 = 参数读取(0, 读路径, 260)
暂存 = 参数读取(1, 写路径, 260)
长度 = 文件读取(读路径, 源, 64)
如果(长度 < 0) { 返回 3 }
长度 = 扫描数字(长度)
如果(文件写入(写路径, 源, 长度) != 长度) { 返回 4 }
输出(长度)
