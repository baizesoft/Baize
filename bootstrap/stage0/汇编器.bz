# Linux x86-64 种子汇编器。固定宽度编码使两遍布局一致。
字节数组 源[262145]
字节数组 物件[1048576]
字节数组 文档路径[4096]
字节数组 目标路径[4096]
# 三个节的暂存布局：各自独立游标，最后写入目标文件。
字节数组 节缓存[262144]
字节数组 信息[65536]
整数 源长 = 0
整数 游标 = 0
整数 行 = 1
整数 失败 = 0
整数 遍 = 1
整数 节 = 1
整数 代码长 = 0
整数 只读长 = 0
整数 零段长 = 0
整数 位置 = 0
整数 名称首 = 0
整数 名称长 = 0
整数 符号数 = 0
整数 入口 = -1
整数 表达值 = 0
整数 表达节 = 0
整数 重定位数 = 0
整数 文件长 = 0
整数 临时 = 0

函数 出错() {
如果(失败 == 0) {
输出("汇编错误，源码行")
输出(行)
}
失败 = 1
返回 0
}

函数 看() {
如果(游标 >= 源长) { 返回 -1 }
返回 源[游标]
}

函数 是横向空白(字符) {
如果(字符 == 32) { 返回 1 }
如果(字符 == 9) { 返回 1 }
返回 字符 == 13
}

函数 空格() {
整数 字符 = 看()
当(是横向空白(字符) == 1) {
游标 = 游标 + 1
字符 = 看()
}
返回 字符
}

函数 接受(期待) {
如果(空格() != 期待) { 返回 0 }
游标 = 游标 + 1
返回 1
}

函数 需要(期待) {
如果(接受(期待) == 0) { 返回 出错() }
返回 1
}

函数 字母(字节) {
如果(字节 == 95) { 返回 1 }
如果(字节 == 46) { 返回 1 }
如果(字节 < 65) { 返回 0 }
如果(字节 <= 90) { 返回 1 }
如果(字节 < 97) { 返回 0 }
返回 字节 <= 122
}

函数 名字() {
整数 字符 = 空格()
名称首 = 游标
名称长 = 0
如果(字母(字符) == 0) { 返回 0 }
游标 = 游标 + 1
名称长 = 1
字符 = 看()
当(字符 >= 0) {
如果(字母(字符) == 0) {
如果(字符 < 48) { 返回 1 }
如果(字符 > 57) { 返回 1 }
}
游标 = 游标 + 1
名称长 = 游标 - 名称首
字符 = 看()
}
返回 1
}

函数 读信息(位置, 宽度) {
整数 数 = 0
整数 索引 = 位置 + 宽度 - 1
如果(宽度 == 8) {
数 = 信息[索引]
如果(数 >= 128) { 数 = 数 - 256 }
索引 = 索引 - 1
}
当(索引 >= 位置) {
数 = 数 * 256 + 信息[索引]
索引 = 索引 - 1
}
返回 数
}

函数 存数(缓冲, 位置, 宽度, 数) {
整数 末尾 = 位置 + 宽度
整数 商 = 0
整数 字节 = 0
当(位置 < 末尾) {
商 = 数 / 256
字节 = 数 - 商 * 256
如果(字节 < 0) {
字节 = 字节 + 256
商 = 商 - 1
}
如果(缓冲 == 1) { 物件[位置] = 字节 }
如果(缓冲 == 2) { 节缓存[位置] = 字节 }
如果(缓冲 == 3) { 信息[位置] = 字节 }
如果(缓冲 == 4) { 操作数[位置] = 字节 }
数 = 商
位置 = 位置 + 1
}
返回 1
}

函数 取位置() {
如果(节 == 1) { 返回 代码长 }
如果(节 == 2) { 返回 只读长 }
返回 零段长
}

函数 保留(数量) {
如果(数量 < 0) { 返回 出错() }
位置 = 取位置()
如果(节 == 1) {
如果(数量 > 131072 - 位置) { 返回 出错() }
代码长 = 代码长 + 数量
返回 1
}
如果(节 == 2) {
如果(数量 > 131072 - 位置) { 返回 出错() }
只读长 = 只读长 + 数量
返回 1
}
如果(数量 > 16777216 - 位置) { 返回 出错() }
零段长 = 零段长 + 数量
返回 1
}

函数 发射(宽度, 数) {
如果(节 == 3) { 返回 出错() }
如果(保留(宽度) == 0) { 返回 0 }
如果(遍 == 2) {
返回 存数(2, (节 - 1) * 131072 + 位置, 宽度, 数)
}
返回 1
}

函数 对齐位置(起, 对齐) {
返回 ((起 + 对齐 - 1) / 对齐) * 对齐
}

函数 名字相等(起, 长, 另起, 另长) {
如果(长 != 另长) { 返回 0 }
整数 游 = 0
当(游 < 长) {
如果(源[起 + 游] != 源[另起 + 游]) { 返回 0 }
游 = 游 + 1
}
返回 1
}

函数 找符号(起, 长) {
整数 序 = 0
整数 记录 = 0
当(序 < 符号数) {
记录 = 序 * 24
如果(名字相等(起, 长, 读信息(记录, 4), 读信息(记录 + 4, 4)) == 1) {
返回 记录
}
序 = 序 + 1
}
返回 -1
}

函数 定义(起, 长, 所在节, 值) {
如果(遍 == 2) { 返回 1 }
如果(找符号(起, 长) >= 0) { 返回 出错() }
如果(符号数 >= 1024) { 返回 出错() }
整数 记录 = 符号数 * 24
整数 暂 = 存数(3, 记录, 4, 起)
暂 = 存数(3, 记录 + 4, 4, 长)
暂 = 存数(3, 记录 + 8, 4, 所在节)
暂 = 存数(3, 记录 + 16, 8, 值)
符号数 = 符号数 + 1
返回 1
}

函数 数字(基数) {
整数 字符 = 看()
整数 数 = 0
整数 位 = 0
当(字符 >= 0) {
位 = 字符 - 48
如果(字符 >= 97) { 位 = 字符 - 87 }
如果(字符 >= 65) {
如果(字符 <= 70) { 位 = 字符 - 55 }
}
如果(位 < 0) { 返回 数 }
如果(位 >= 基数) { 返回 数 }
如果(字符 > 57) {
如果(字符 < 65) { 返回 数 }
如果(字符 > 70) {
如果(字符 < 97) { 返回 数 }
}
}
如果(数 > (9223372036854775807 - 位) / 基数) { 返回 出错() }
数 = 数 * 基数 + 位
游标 = 游标 + 1
字符 = 看()
}
返回 数
}

函数 读转义() {
整数 字符 = 看()
如果(字符 < 0) { 返回 出错() }
如果(字符 == 10) { 返回 出错() }
游标 = 游标 + 1
如果(字符 != 92) { 返回 字符 }
字符 = 看()
如果(字符 < 0) { 返回 出错() }
游标 = 游标 + 1
如果(字符 == 110) { 返回 10 }
如果(字符 == 116) { 返回 9 }
如果(字符 == 92) { 返回 92 }
如果(字符 == 34) { 返回 34 }
如果(字符 == 39) { 返回 39 }
返回 出错()
}

函数 表达原子() {
整数 字符 = 空格()
整数 记录 = 0
整数 起 = 游标
表达节 = 0
如果(字符 == 39) {
游标 = 游标 + 1
表达值 = 读转义()
返回 需要(39)
}
如果(字符 >= 48) {
如果(字符 <= 57) {
如果(字符 == 48) {
如果(游标 + 1 < 源长) {
如果(源[游标 + 1] == 120) {
游标 = 游标 + 2
起 = 游标
表达值 = 数字(16)
如果(游标 == 起) { 返回 出错() }
返回 1
}
}
}
表达值 = 数字(10)
返回 1
}
}
如果(名字() == 0) { 返回 出错() }
如果(名称长 == 1) {
如果(源[名称首] == 46) {
表达节 = 节
表达值 = 取位置()
返回 1
}
}
记录 = 找符号(名称首, 名称长)
如果(记录 < 0) {
如果(遍 == 2) { 返回 出错() }
表达节 = -1
表达值 = 0
返回 1
}
表达节 = 读信息(记录 + 8, 4)
表达值 = 读信息(记录 + 16, 8)
返回 1
}

函数 表达项() {
整数 暂 = 表达原子()
整数 数 = 表达值
整数 所在 = 表达节
当(接受(42) == 1) {
暂 = 表达原子()
如果(所在 > 0) { 返回 出错() }
如果(表达节 > 0) { 返回 出错() }
如果(表达节 < 0) { 所在 = -1 }
如果(所在 == 0) {
如果(数 < 0) { 返回 出错() }
如果(表达值 < 0) { 返回 出错() }
如果(表达值 != 0) {
如果(数 > 9223372036854775807 / 表达值) { 返回 出错() }
}
数 = 数 * 表达值
}
}
表达值 = 数
表达节 = 所在
返回 1
}

函数 加减合并(旧节, 旧值, 运算) {
如果(旧节 < 0) { 表达节 = -1 }
如果(表达节 < 0) {
表达值 = 0
返回 1
}
如果(运算 == 43) {
如果(旧节 > 0) {
如果(表达节 != 0) { 返回 出错() }
表达节 = 旧节
}
如果(表达值 > 0) {
如果(旧值 > 9223372036854775807 - 表达值) { 返回 出错() }
}
如果(表达值 < 0) {
如果(旧值 < -9223372036854775807 - 1 - 表达值) { 返回 出错() }
}
表达值 = 旧值 + 表达值
返回 1
}
如果(表达节 > 0) {
如果(旧节 != 表达节) { 返回 出错() }
表达节 = 0
} 否则 { 表达节 = 旧节 }
如果(表达值 > 0) {
如果(旧值 < -9223372036854775807 - 1 + 表达值) { 返回 出错() }
}
如果(表达值 < 0) {
如果(旧值 > 9223372036854775807 + 表达值) { 返回 出错() }
}
表达值 = 旧值 - 表达值
返回 1
}

函数 是加减(运) {
如果(运 == 43) { 返回 1 }
返回 运 == 45
}

函数 表达式() {
整数 符 = 接受(45)
整数 暂 = 表达项()
如果(符 == 1) {
如果(表达节 > 0) { 返回 出错() }
如果(表达值 == -9223372036854775807 - 1) { 返回 出错() }
表达值 = 0 - 表达值
}
整数 数 = 0
整数 所在 = 0
整数 运 = 空格()
当(是加减(运) == 1) {
数 = 表达值
所在 = 表达节
游标 = 游标 + 1
暂 = 表达项()
暂 = 加减合并(所在, 数, 运)
运 = 空格()
}
返回 1
}

# Each record: target section, patch offset, symbol section, type, addend.
函数 记录重定位(目标, 偏移, 所在, 类型, 加数) {
如果(遍 == 1) { 返回 1 }
如果(重定位数 >= 1024) { 返回 出错() }
整数 记录 = 24576 + 重定位数 * 32
整数 暂 = 存数(3, 记录, 4, 目标)
暂 = 存数(3, 记录 + 4, 4, 偏移)
暂 = 存数(3, 记录 + 8, 4, 所在)
暂 = 存数(3, 记录 + 12, 4, 类型)
暂 = 存数(3, 记录 + 16, 8, 加数)
重定位数 = 重定位数 + 1
返回 1
}

函数 发射绝对(宽度) {
整数 暂 = 0
如果(表达节 != 0) {
如果(宽度 != 8) {
如果(遍 == 2) { 返回 出错() }
}
如果(遍 == 2) {
暂 = 记录重定位(节, 取位置(), 表达节, 1, 表达值)
}
返回 发射(宽度, 0)
}
返回 发射(宽度, 表达值)
}

函数 发射相对(余宽) {
整数 字段 = 取位置()
如果(遍 == 1) { 返回 发射(4, 0) }
如果(表达节 == 节) {
整数 差 = 表达值 - 字段 - 4 - 余宽
如果(差 < -2147483648) { 返回 出错() }
如果(差 > 2147483647) { 返回 出错() }
返回 发射(4, 差)
}
如果(表达节 <= 0) { 返回 出错() }
整数 暂 = 记录重定位(节, 字段, 表达节, 2, 表达值 - 4 - 余宽)
返回 发射(4, 0)
}

函数 保留词(起, 长) {
如果(长 > 16) { 返回 0 }
整数 前 = 0
整数 中 = 0
整数 后 = 0
整数 尾 = 0
整数 游 = 0
当(游 < 长) {
如果(游 < 4) { 前 = 前 * 256 + 源[起 + 游] } 否则 {
如果(游 < 8) { 中 = 中 * 256 + 源[起 + 游] } 否则 {
如果(游 < 12) { 后 = 后 * 256 + 源[起 + 游] } 否则 { 尾 = 尾 * 256 + 源[起 + 游] }
}
}
游 = 游 + 1
}
