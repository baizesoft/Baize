如果(表达节 != 0) { 返回 出错() }
返回 保留(表达值)
}
如果(词 == 17) {
如果(节 != 3) { 返回 出错() }
如果(名字() == 0) { 返回 出错() }
名首 = 名称首
名长 = 名称长
暂 = 需要(44)
暂 = 表达式()
如果(表达节 != 0) { 返回 出错() }
大小 = 表达值
如果(大小 <= 0) { 返回 出错() }
暂 = 保留(对齐位置(零段长, 8) - 零段长)
暂 = 定义(名首, 名长, 3, 零段长)
返回 保留(大小)
}
如果(词 == 12) { 宽 = 1 }
如果(词 == 13) { 宽 = 2 }
如果(词 == 14) { 宽 = 4 }
如果(词 == 15) { 宽 = 8 }
如果(宽 == 0) { 返回 出错() }
暂 = 表达式()
暂 = 发射数据(宽)
当(接受(44) == 1) {
暂 = 表达式()
暂 = 发射数据(宽)
}
返回 1
}

函数 发射数据(宽) {
如果(遍 == 2) {
如果(表达节 == 0) {
如果(宽 == 1) {
如果(表达值 < -128) { 返回 出错() }
如果(表达值 > 255) { 返回 出错() }
}
如果(宽 == 2) {
如果(表达值 < -32768) { 返回 出错() }
如果(表达值 > 65535) { 返回 出错() }
}
如果(宽 == 4) {
如果(表达值 < -2147483648) { 返回 出错() }
如果(表达值 > 4294967295) { 返回 出错() }
}
}
}
返回 发射绝对(宽)
}

函数 汇编一行() {
整数 字符 = 空格()
整数 词 = 0
整数 起 = 0
整数 长 = 0
整数 暂 = 0
当(字符 > 0) {
如果(字符 == 10) { 返回 1 }
如果(字符 == 35) { 返回 1 }
如果(名字() == 0) { 返回 出错() }
起 = 名称首
长 = 名称长
词 = 保留词(起, 长)
如果(接受(58) == 1) {
如果(节 > 3) { 返回 出错() }
暂 = 定义(起, 长, 节, 取位置())
如果(词 == 19) {
如果(节 != 1) { 返回 出错() }
入口 = 取位置()
}
字符 = 空格()
} 否则 {
如果(源[起] == 46) { 返回 指示(词) }
返回 指令(词)
}
}
返回 1
}

函数 扫描() {
游标 = 0
节 = 1
行 = 1
代码长 = 0
只读长 = 0
零段长 = 0
整数 暂 = 0
整数 字符 = 0
当(游标 < 源长) {
暂 = 汇编一行()
如果(失败 != 0) { 返回 0 }
字符 = 空格()
如果(字符 == 35) {
暂 = 跳注释()
字符 = 看()
}
如果(游标 >= 源长) { 返回 1 }
如果(字符 != 10) { 返回 出错() }
游标 = 游标 + 1
行 = 行 + 1
}
返回 1
}

函数 跳注释() {
当(游标 < 源长) {
如果(看() == 10) { 返回 1 }
游标 = 游标 + 1
}
返回 1
}

函数 拷贝(来源, 长度, 目标) {
整数 游 = 0
当(游 < 长度) {
物件[目标 + 游] = 节缓存[来源 + 游]
游 = 游 + 1
}
返回 1
}

整数 节表偏移 = 0

函数 写节(序, 名, 类型, 标志, 偏移, 大小, 链接, 信息值, 对齐, 项宽) {
整数 位 = 节表偏移 + 序 * 64
整数 暂 = 存数(1, 位, 4, 名)
暂 = 存数(1, 位 + 4, 4, 类型)
暂 = 存数(1, 位 + 8, 8, 标志)
暂 = 存数(1, 位 + 24, 8, 偏移)
暂 = 存数(1, 位 + 32, 8, 大小)
暂 = 存数(1, 位 + 40, 4, 链接)
暂 = 存数(1, 位 + 44, 4, 信息值)
暂 = 存数(1, 位 + 48, 8, 对齐)
返回 存数(1, 位 + 56, 8, 项宽)
}

函数 重定位项数(目标) {
整数 序 = 0
整数 数 = 0
当(序 < 重定位数) {
如果(读信息(24576 + 序 * 32, 4) == 目标) { 数 = 数 + 1 }
序 = 序 + 1
}
返回 数
}

函数 写重定位(目标, 起) {
整数 序 = 0
整数 记录 = 0
整数 暂 = 0
当(序 < 重定位数) {
记录 = 24576 + 序 * 32
如果(读信息(记录, 4) == 目标) {
暂 = 存数(1, 起, 8, 读信息(记录 + 4, 4))
暂 = 存数(1, 起 + 8, 4, 读信息(记录 + 12, 4))
暂 = 存数(1, 起 + 12, 4, 读信息(记录 + 8, 4))
暂 = 存数(1, 起 + 16, 8, 读信息(记录 + 16, 8))
起 = 起 + 24
}
序 = 序 + 1
}
返回 1
}

