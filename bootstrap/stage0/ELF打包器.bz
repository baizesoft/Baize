# 将单个 x86-64 ET_REL 打包成独立 ET_EXEC。
字节数组 输入[1048577]
字节数组 输出缓存[1048576]
字节数组 输入路径[4096]
字节数组 输出路径[4096]
整数 输入长度 = 0
整数 输出长度 = 0
整数 节表 = 0
整数 节数 = 0
整数 代码节 = 0
整数 只读节 = 0
整数 零数据节 = 0
整数 符号节 = 0
整数 符号表 = 0
整数 符号数 = 0
整数 字符表 = 0
整数 字符长度 = 0
整数 基址 = 4194304
整数 代码偏移 = 4096
整数 只读偏移 = 0
整数 零数据偏移 = 0
整数 入口地址 = 0
整数 状态 = 0

函数 读数(位置, 宽度) {
整数 值 = 0
整数 游标 = 位置 + 宽度 - 1
如果(宽度 == 8) {
值 = 输入[游标]
如果(值 >= 128) { 值 = 值 - 256 }
游标 = 游标 - 1
}
当(游标 >= 位置) {
值 = 值 * 256 + 输入[游标]
游标 = 游标 - 1
}
返回 值
}

函数 写数(位置, 宽度, 值) {
整数 商 = 0
整数 字节 = 0
整数 游标 = 0
当(游标 < 宽度) {
商 = 值 / 256
字节 = 值 - 商 * 256
如果(字节 < 0) {
字节 = 字节 + 256
商 = 商 - 1
}
输出缓存[位置 + 游标] = 字节
值 = 商
游标 = 游标 + 1
}
返回 1
}

函数 在输入内(位置, 大小) {
如果(位置 < 0) { 返回 0 }
如果(大小 < 0) { 返回 0 }
如果(位置 > 输入长度) { 返回 0 }
返回 大小 <= 输入长度 - 位置
}

函数 页对齐(地址) {
返回 ((地址 + 4095) / 4096) * 4096
}

函数 节头(序号) {
返回 节表 + 序号 * 64
}

函数 节偏移(序号) {
返回 读数(节头(序号) + 24, 8)
}

函数 节长度(序号) {
返回 读数(节头(序号) + 32, 8)
}

函数 读取节表() {
如果(输入长度 < 64) { 返回 0 }
如果(读数(0, 4) != 1179403647) { 返回 0 }
如果(读数(4, 4) != 65794) { 返回 0 }
如果(读数(16, 2) != 1) { 返回 0 }
如果(读数(18, 2) != 62) { 返回 0 }
如果(读数(20, 4) != 1) { 返回 0 }
如果(读数(52, 2) != 64) { 返回 0 }
如果(读数(56, 2) != 0) { 返回 0 }
如果(读数(58, 2) != 64) { 返回 0 }
节表 = 读数(40, 8)
节数 = 读数(60, 2)
如果(节数 < 2) { 返回 0 }
如果(节表 < 64) { 返回 0 }
如果(在输入内(节表, 节数 * 64) == 0) { 返回 0 }
整数 序号 = 1
整数 头 = 0
整数 种类 = 0
整数 标志 = 0
整数 大小 = 0
整数 对齐 = 0
当(序号 < 节数) {
头 = 节头(序号)
种类 = 读数(头 + 4, 4)
标志 = 读数(头 + 8, 8)
大小 = 节长度(序号)
如果(大小 < 0) { 返回 0 }
如果(种类 != 8) {
如果(在输入内(节偏移(序号), 大小) == 0) { 返回 0 }
}
如果(种类 == 2) {
如果(符号节 != 0) { 返回 0 }
符号节 = 序号
}
如果(种类 == 9) { 返回 0 }
如果(标志 < 0) { 返回 0 }
如果(标志 / 2 - (标志 / 4) * 2 == 1) {
对齐 = 读数(头 + 48, 8)
如果(对齐 < 1) { 返回 0 }
如果(对齐 > 4096) { 返回 0 }
如果((4096 / 对齐) * 对齐 != 4096) { 返回 0 }
如果(种类 == 1) {
如果(标志 == 6) {
如果(代码节 != 0) { 返回 0 }
代码节 = 序号
} 否则 {
如果(标志 == 2) {
如果(只读节 != 0) { 返回 0 }
只读节 = 序号
} 否则 {
如果(标志 != 3) { 返回 0 }
如果(大小 != 0) { 返回 0 }
}
}
} 否则 {
如果(种类 != 8) { 返回 0 }
如果(标志 != 3) { 返回 0 }
如果(零数据节 != 0) { 返回 0 }
零数据节 = 序号
}
}
序号 = 序号 + 1
}
如果(代码节 == 0) { 返回 0 }
如果(符号节 == 0) { 返回 0 }
返回 节长度(代码节) > 0
}

函数 读取符号表() {
整数 头 = 节头(符号节)
整数 字符节 = 读数(头 + 40, 4)
整数 大小 = 节长度(符号节)
如果(读数(头 + 56, 8) != 24) { 返回 0 }
如果(字符节 < 1) { 返回 0 }
如果(字符节 >= 节数) { 返回 0 }
如果(读数(节头(字符节) + 4, 4) != 3) { 返回 0 }
符号表 = 节偏移(符号节)
符号数 = 大小 / 24
如果(符号数 * 24 != 大小) { 返回 0 }
如果(符号数 < 2) { 返回 0 }
字符表 = 节偏移(字符节)
字符长度 = 节长度(字符节)
返回 字符长度 > 0
}

函数 布置段() {
只读偏移 = 页对齐(代码偏移 + 节长度(代码节))
输出长度 = 只读偏移
如果(只读节 != 0) {
输出长度 = 只读偏移 + 节长度(只读节)
}
如果(输出长度 > 1048576) { 返回 0 }
零数据偏移 = 页对齐(输出长度)
如果(零数据节 != 0) {
如果(节长度(零数据节) > 16777216) { 返回 0 }
}
返回 1
}

函数 映射偏移(节) {
如果(节 == 代码节) { 返回 代码偏移 }
如果(节 == 0) { 返回 -1 }
如果(节 == 只读节) { 返回 只读偏移 }
如果(节 == 零数据节) { 返回 零数据偏移 }
返回 -1
}

函数 入口名称(位置) {
如果(位置 < 0) { 返回 0 }
如果(位置 > 字符长度 - 7) { 返回 0 }
位置 = 字符表 + 位置
如果(读数(位置, 4) != 1635021663) { 返回 0 }
返回 读数(位置 + 4, 3) == 29810
}

函数 查找入口() {
整数 序号 = 1
整数 符号 = 0
整数 偏移 = 0
当(序号 < 符号数) {
符号 = 符号表 + 序号 * 24
如果(入口名称(读数(符号, 4)) == 1) {
如果(入口地址 != 0) { 返回 0 }
如果(输入[符号 + 4] / 16 != 1) { 返回 0 }
如果(读数(符号 + 6, 2) != 代码节) { 返回 0 }
偏移 = 读数(符号 + 8, 8)
如果(偏移 < 0) { 返回 0 }
如果(偏移 >= 节长度(代码节)) { 返回 0 }
入口地址 = 基址 + 代码偏移 + 偏移
}
序号 = 序号 + 1
}
返回 入口地址 != 0
}

函数 拷贝节(节, 目的) {
整数 起点 = 节偏移(节)
整数 大小 = 节长度(节)
整数 游标 = 0
当(游标 < 大小) {
输出缓存[目的 + 游标] = 输入[起点 + 游标]
游标 = 游标 + 1
}
返回 1
}

函数 回填一项(记录, 目标节, 目的) {
整数 种类 = 读数(记录 + 8, 4)
整数 序号 = 读数(记录 + 12, 4)
整数 位置 = 读数(记录, 8)
整数 加数 = 读数(记录 + 16, 8)
整数 宽度 = 0
整数 符号 = 0
整数 符号所在节 = 0
整数 偏移 = 0
整数 节内值 = 0
整数 地址 = 0
整数 值 = 0
如果(种类 == 1) { 宽度 = 8 }
如果(种类 == 2) { 宽度 = 4 }
如果(宽度 == 0) {
输出("ELF 打包错误：不支持的重定位")
返回 0
}
如果(位置 < 0) { 返回 0 }
如果(位置 > 节长度(目标节) - 宽度) { 返回 0 }
如果(序号 < 1) { 返回 0 }
如果(序号 >= 符号数) { 返回 0 }
符号 = 符号表 + 序号 * 24
符号所在节 = 读数(符号 + 6, 2)
偏移 = 映射偏移(符号所在节)
如果(偏移 < 0) {
输出("ELF 打包错误：符号未定义或所在节不受支持")
返回 0
}
节内值 = 读数(符号 + 8, 8)
如果(节内值 < 0) { 返回 0 }
如果(节内值 > 节长度(符号所在节)) { 返回 0 }
地址 = 基址 + 偏移 + 节内值
如果(宽度 == 4) {
# 先减去 P，以便检查带符号加数且避免中间溢出。
值 = 地址 - (基址 + 目的 + 位置)
如果(加数 < -2147483648 - 值) { 返回 0 }
如果(加数 > 2147483647 - 值) { 返回 0 }
返回 写数(目的 + 位置, 宽度, 值 + 加数)
}
# S 为正数。通过无符号 64 位编码保留 S+A 的模 2^64 结果。
如果(加数 > 9223372036854775807 - 地址) {
值 = -9223372036854775807 - 1 + (加数 - (9223372036854775807 - 地址) - 1)
} 否则 {
值 = 地址 + 加数
}
返回 写数(目的 + 位置, 宽度, 值)
}

函数 应用重定位() {
整数 序号 = 1
整数 头 = 0
整数 目标 = 0
整数 目的 = 0
整数 游标 = 0
整数 长度 = 0
整数 终点 = 0
当(序号 < 节数) {
头 = 节头(序号)
如果(读数(头 + 4, 4) == 4) {
如果(读数(头 + 40, 4) != 符号节) { 返回 0 }
如果(读数(头 + 56, 8) != 24) { 返回 0 }
目标 = 读数(头 + 44, 4)
如果(目标 == 零数据节) { 返回 0 }
目的 = 映射偏移(目标)
如果(目的 < 0) { 返回 0 }
游标 = 节偏移(序号)
长度 = 节长度(序号)
如果((长度 / 24) * 24 != 长度) { 返回 0 }
终点 = 游标 + 长度
当(游标 < 终点) {
如果(回填一项(游标, 目标, 目的) == 0) { 返回 0 }
游标 = 游标 + 24
}
}
序号 = 序号 + 1
}
返回 1
}

函数 写段(位置, 类型, 权限, 文件偏移, 地址, 文件大小, 内存大小, 对齐) {
整数 临时 = 写数(位置, 4, 类型)
临时 = 写数(位置 + 4, 4, 权限)
临时 = 写数(位置 + 8, 8, 文件偏移)
临时 = 写数(位置 + 16, 8, 地址)
临时 = 写数(位置 + 24, 8, 地址)
临时 = 写数(位置 + 32, 8, 文件大小)
临时 = 写数(位置 + 40, 8, 内存大小)
返回 写数(位置 + 48, 8, 对齐)
}

函数 写头() {
整数 临时 = 写数(0, 4, 1179403647)
临时 = 写数(4, 4, 65794)
临时 = 写数(16, 2, 2)
临时 = 写数(18, 2, 62)
临时 = 写数(20, 4, 1)
临时 = 写数(24, 8, 入口地址)
临时 = 写数(32, 8, 64)
临时 = 写数(52, 2, 64)
临时 = 写数(54, 2, 56)
整数 下一项 = 120
整数 代码末尾 = 代码偏移 + 节长度(代码节)
临时 = 写段(64, 1, 5, 0, 基址, 代码末尾, 代码末尾, 4096)
如果(只读节 != 0) {
临时 = 写段(下一项, 1, 4, 只读偏移, 基址 + 只读偏移, 节长度(只读节), 节长度(只读节), 4096)
下一项 = 下一项 + 56
}
如果(零数据节 != 0) {
临时 = 写段(下一项, 1, 6, 0, 基址 + 零数据偏移, 0, 节长度(零数据节), 4096)
下一项 = 下一项 + 56
}
临时 = 写段(下一项, 1685382481, 6, 0, 0, 0, 0, 16)
返回 写数(56, 2, (下一项 - 64) / 56 + 1)
}

如果(参数数量() != 2) {
输出("用法：ELF打包器 输入.o 输出.elf")
返回 2
}
状态 = 参数读取(0, 输入路径, 4096)
如果(状态 <= 0) { 返回 2 }
如果(状态 >= 4095) { 返回 2 }
状态 = 参数读取(1, 输出路径, 4096)
如果(状态 <= 0) { 返回 2 }
如果(状态 >= 4095) { 返回 2 }
输入长度 = 文件读取(输入路径, 输入, 1048577)
如果(输入长度 > 1048576) { 返回 1 }
如果(读取节表() == 0) { 输出("ELF 打包错误：无效或不支持的节表")
返回 1 }
如果(读取符号表() == 0) { 输出("ELF 打包错误：无效的符号表")
返回 1 }
如果(布置段() == 0) { 输出("ELF 打包错误：段大小超过上限")
返回 1 }
如果(查找入口() == 0) { 输出("ELF 打包错误：缺少有效的 _start 入口")
返回 1 }
状态 = 拷贝节(代码节, 代码偏移)
如果(只读节 != 0) { 状态 = 拷贝节(只读节, 只读偏移) }
如果(应用重定位() == 0) { 输出("ELF 打包错误：无法应用重定位")
返回 1 }
状态 = 写头()
如果(文件写入(输出路径, 输出缓存, 输出长度) != 输出长度) {
输出("ELF 打包错误：无法写入输出")
返回 1
}
