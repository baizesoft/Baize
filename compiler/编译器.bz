整数 实参根 = 0
原生参数数 = 0
当(原生参数 > 0) {
原生左 = 读取节点左(原生参数 - 1) - 1
如果(原生发射表达式(原生左) == 0) { 返回 0 }
如果(使用向量 == 1) { 实参根 = 实参根 + 向量表达式[原生左] }
原生参数数 = 原生参数数 + 1
原生参数 = 读取节点后继(原生参数 - 1)
}
如果(原生内置入口 > 0) {
如果(原生参数数 != 原生内置元数) { 返回 0 }
暂存 = 原生追加字节(232)
暂存 = 原生追加整数(原生补32(原生内置入口 - 原生输出长度 - 4), 4)
} 否则 {
如果(原生参数数 != 原生函数参数数[原生目标 - 1]) { 返回 0 }
暂存 = 原生追加字节(232)
原生坑 = 原生输出长度
暂存 = 原生追加整数(0, 4)
如果(原生记调用坑(原生坑, 原生目标) == 0) { 返回 0 }
}
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(129)
暂存 = 原生追加字节(196)
暂存 = 原生追加整数(8 * 原生参数数, 4)
如果(使用向量 == 1) { 暂存 = 原生弹根(实参根) }
暂存 = 原生压值()
返回 1
}
返回 0
}
函数 原生发射块(块编号) {
整数 原生当前 = 0
整数 外层槽数 = 原生槽数
如果(块编号 <= 0) { 返回 1 }
原生块深度 = 原生块深度 + 1
原生当前 = 读取节点左(块编号 - 1)
当(原生当前 > 0) {
如果(原生发射语句(原生当前 - 1) == 0) {
原生槽数 = 外层槽数
原生块深度 = 原生块深度 - 1
返回 0
}
原生当前 = 读取节点后继(原生当前 - 1)
}
原生槽数 = 外层槽数
原生块深度 = 原生块深度 - 1
返回 1
}
