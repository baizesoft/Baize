如果(任务内置 == 9) { 返回 原生发射启动任务(原生参数) }
如果(匹配词元12(原生词元, 229, 143, 130, 230, 149, 176, 230, 149, 176, 233, 135, 143) == 1) {
如果(原生参数 != 0) { 返回 0 }
如果(原生模式 == 2) {
# mov rax, r12; dec rax
