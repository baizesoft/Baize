整数 原生计数 = 0
原生块 = 读取节点左(编号)
原生参数 = 读取节点右(编号)
原生槽数 = 0
原生返回坑数 = 0
原生参数数 = 0
当(原生参数 > 0) {
如果(原生加槽(读取节点记号(原生参数 - 1)) == 0) { 返回 0 }
原生参数数 = 原生参数数 + 1
原生参数 = 读取节点后继(原生参数 - 1)
}
如果(序号 >= 原生函数数) { 返回 0 }
原生函数入口低[序号] = 生成C长度 - (生成C长度 / 256) * 256
原生函数入口高[序号] = 生成C长度 / 256
原生函数入口更高[序号] = 生成C长度 / 65536
暂存 = 追加C字节(85)
