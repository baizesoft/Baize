如果(值 / 16 < 10) { 暂存 = 追加C字节(48 + 值 / 16) } 否则 { 暂存 = 追加C字节(55 + 值 / 16) }
值 = 值 - (值 / 16) * 16
如果(值 < 10) { 暂存 = 追加C字节(48 + 值) } 否则 { 暂存 = 追加C字节(55 + 值) }
