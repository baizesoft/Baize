暂存 = 追加C字节(129)
暂存 = 追加C字节(236)
暂存 = 原生追加整数(原生帧大小, 4)
原生计数 = 1
当(原生计数 <= 原生参数数) {
暂存 = 原生送帧值(8 * (原生参数数 - 原生计数 + 2))
暂存 = 原生存帧值(0 - 8 * 原生计数)
原生计数 = 原生计数 + 1
}
如果(原生发射块(原生块) == 0) { 返回 0 }
暂存 = 原生帧清零(0 - 原生返回偏移)
原生目标偏移 = 生成C长度
暂存 = 原生送帧值(0 - 原生返回偏移)
暂存 = 追加C字节(72)
暂存 = 追加C字节(137)
暂存 = 追加C字节(236)
暂存 = 追加C字节(93)
暂存 = 追加C字节(195)
原生计数 = 0
当(原生计数 < 原生返回坑数) {
原生源偏移 = 原生返回坑低[原生计数] + 原生返回坑高[原生计数] * 256 + 原生返回坑更高[原生计数] * 65536
暂存 = 原生补相对四(原生源偏移, 原生目标偏移)
原生计数 = 原生计数 + 1
}
返回 1
}
