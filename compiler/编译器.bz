函数 原生发射函数体(编号, 序号) {
整数 原生参数 = 0
整数 原生参数数 = 0
整数 原生块 = 0
整数 原生源偏移 = 0
整数 原生目标偏移 = 0
整数 原生计数 = 0
原生块 = 读取节点左(编号)
原生参数 = 读取节点右(编号)
原生槽数 = 0
原生返回坑数 = 0
原生参数数 = 0
当(原生参数 > 0) {
如果(原生加槽(读取节点记号(原生参数 - 1)) == 0) { 返回 0 }
原生参数数 = 原生参数数 + 1
原生参数 = 读取节点后继(原生参数 - 1)
}
如果(序号 >= 原生函数数) { 返回 0 }
原生函数入口低[序号] = 原生输出长度 - (原生输出长度 / 256) * 256
原生函数入口高[序号] = 原生输出长度 / 256
原生函数入口更高[序号] = 原生输出长度 / 65536
暂存 = 原生追加字节(85)
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(137)
暂存 = 原生追加字节(229)
如果(使用任务 == 1) { 暂存 = 原生短调用(原生任务栈检查入口) }
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(129)
暂存 = 原生追加字节(236)
暂存 = 原生追加整数(原生帧大小, 4)
如果(使用向量 == 1) {
暂存 = 原生短调用(原生根基入口)
# mov [rbp-根基偏移],rdx
暂存 = 原生追加整数(9800008, 3)
暂存 = 原生追加整数(原生补32(0 - 原生根基偏移), 4)
}
原生参数 = 读取节点右(编号)
原生计数 = 1
当(原生计数 <= 原生参数数) {
暂存 = 原生送帧值(8 * (原生参数数 - 原生计数 + 2))
暂存 = 原生存帧值(0 - 8 * 原生计数)
如果(使用向量 == 1) {
如果(节点静态类型[原生参数 - 1] == 5) { 暂存 = 原生根帧入(原生计数) }
原生参数 = 读取节点后继(原生参数 - 1)
}
原生计数 = 原生计数 + 1
}
如果(原生发射块(原生块) == 0) { 返回 0 }
暂存 = 原生帧清零(0 - 原生返回偏移)
原生目标偏移 = 原生输出长度
如果(使用向量 == 1) {
# mov rdx,[rbp-根基偏移]，统一出口撤销本栈帧所有登记。
暂存 = 原生追加整数(9800520, 3)
暂存 = 原生追加整数(原生补32(0 - 原生根基偏移), 4)
暂存 = 原生短调用(原生根复位入口)
}
暂存 = 原生送帧值(0 - 原生返回偏移)
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(137)
暂存 = 原生追加字节(236)
暂存 = 原生追加字节(93)
暂存 = 原生追加字节(195)
原生计数 = 0
当(原生计数 < 原生返回坑数) {
原生源偏移 = 原生返回坑低[原生计数] + 原生返回坑高[原生计数] * 256 + 原生返回坑更高[原生计数] * 65536
暂存 = 原生补相对四(原生源偏移, 原生目标偏移)
原生计数 = 原生计数 + 1
}
返回 1
}
# 按实际内置调用链接 stderr。编译器本身未调用它，现有种子仍可生成同一映像。
函数 原生需要错误流() {
整数 序号 = 0
整数 词元 = 0
当(序号 < 节点数) {
如果(节点种类[序号] == 7) {
词元 = 读取节点记号(序号)
如果(是错误输出字节(词元) == 1) {
如果(原生查找函数(词元) == 0) { 返回 1 }
}
}
序号 = 序号 + 1
}
返回 0
}
函数 程序使用向量() {
整数 序号 = 0
整数 词元 = 0
当(序号 < 节点数) {
如果(节点种类[序号] == 7) {
词元 = 读取节点记号(序号)
如果(是新建字节向量(词元) == 1) { 返回 1 }
如果(是向量长度(词元) == 1) { 返回 1 }
如果(是向量读字节(词元) == 1) { 返回 1 }
如果(是向量写字节(词元) == 1) { 返回 1 }
}
序号 = 序号 + 1
}
返回 0
}
