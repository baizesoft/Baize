如果(暂存 == 0) { 返回 0 }
返回 1
}
# ===================================================================
# 原生函数后端：从已解析的 AST 生成真实 x86-64 机器码（静态 ELF）
# 约定：表达式把值压在 CPU 栈上；RAX 为返回寄存器；每个函数独立
# 栈帧，形参复制到 [rbp-8*i]，返回槽在 [rbp-原生返回偏移]。
# 调用/跳转统一用相对偏移回填，递归时中间值始终留在栈中不被占用。
# ===================================================================
函数 原生补32(值) {
如果(值 < 0) { 返回 值 + 4294967296 }
返回 值
}
函数 原生压值() {
如果(使用任务 == 1) { 暂存 = 原生短调用(原生任务栈检查入口) }
暂存 = 原生追加字节(80)
返回 1
}
函数 原生弹值() {
暂存 = 原生追加字节(88)
返回 1
}
函数 原生压右() {
暂存 = 原生追加字节(81)
返回 1
}
函数 原生弹右() {
暂存 = 原生追加字节(89)
返回 1
}
函数 原生送立即(值) {
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(184)
暂存 = 原生追加整数(值, 8)
返回 1
}
函数 原生送帧值(偏移) {
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(139)
暂存 = 原生追加字节(133)
暂存 = 原生追加整数(原生补32(偏移), 4)
返回 1
}
函数 原生存帧值(偏移) {
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(137)
暂存 = 原生追加字节(133)
暂存 = 原生追加整数(原生补32(偏移), 4)
返回 1
}
函数 原生帧清零(偏移) {
暂存 = 原生追加字节(72)
暂存 = 原生追加字节(199)
暂存 = 原生追加字节(133)
暂存 = 原生追加整数(原生补32(偏移), 4)
暂存 = 原生追加整数(0, 4)
返回 1
}
函数 原生补相对8(位置, 目标) {
整数 原生差 = 目标 - 位置 - 1
如果(原生差 < 0) { 原生差 = 原生差 + 256 }
原生输出缓存[位置] = 原生差 - (原生差 / 256) * 256
返回 1
}
函数 原生补相对四(位置, 目标) {
暂存 = 原生写缓存4(位置, 原生补32(目标 - 位置 - 4))
返回 1
}
函数 原生记号相等(甲, 乙) {
如果(词长[甲] != 词长[乙]) { 返回 0 }
整数 原生游标 = 读取起点(甲)
整数 原生乙游标 = 读取起点(乙)
整数 原生剩余 = 词长[甲]
当(原生剩余 > 0) {
如果(源[原生游标] != 源[原生乙游标]) { 返回 0 }
原生游标 = 原生游标 + 1
原生乙游标 = 原生乙游标 + 1
原生剩余 = 原生剩余 - 1
}
返回 1
}
函数 原生查找槽(词元) {
整数 原生索引 = 原生槽数
当(原生索引 > 0) {
原生索引 = 原生索引 - 1
如果(原生记号相等(原生槽名低[原生索引] + 原生槽名高[原生索引] * 256, 词元) == 1) {
返回 原生槽号[原生索引]
}
}
返回 0
}
函数 原生加槽(词元) {
如果(原生槽数 >= 64) { 返回 0 }
原生槽名低[原生槽数] = 词元 - (词元 / 256) * 256
原生槽名高[原生槽数] = 词元 / 256
原生槽数 = 原生槽数 + 1
原生槽号[原生槽数 - 1] = 原生槽数
返回 原生槽数
}
函数 原生查找函数(词元) {
整数 原生索引 = 0
当(原生索引 < 原生函数数) {
如果(原生记号相等(原生函数名字低[原生索引] + 原生函数名字高[原生索引] * 256, 词元) == 1) {
返回 原生索引 + 1
}
原生索引 = 原生索引 + 1
}
返回 0
}
函数 原生注册函数(词元, 参数数) {
如果(原生函数数 >= 255) { 返回 0 }
原生函数名字低[原生函数数] = 词元 - (词元 / 256) * 256
原生函数名字高[原生函数数] = 词元 / 256
原生函数参数数[原生函数数] = 参数数
原生函数数 = 原生函数数 + 1
返回 原生函数数
}
函数 原生记调用坑(位置, 目标) {
如果(原生调用坑数 >= 16384) { 返回 0 }
原生调用坑低[原生调用坑数] = 位置 - (位置 / 256) * 256
原生调用坑高[原生调用坑数] = 位置 / 256
原生调用坑更高[原生调用坑数] = 位置 / 65536
原生调用目标[原生调用坑数] = 目标
原生调用坑数 = 原生调用坑数 + 1
返回 1
}
函数 原生记返回坑(位置) {
如果(原生返回坑数 >= 256) { 返回 0 }
原生返回坑低[原生返回坑数] = 位置 - (位置 / 256) * 256
原生返回坑高[原生返回坑数] = 位置 / 256
原生返回坑更高[原生返回坑数] = 位置 / 65536
原生返回坑数 = 原生返回坑数 + 1
返回 1
}
函数 原生解析整数(词元) {
整数 原生结果 = 0
整数 原生游标 = 读取起点(词元)
整数 原生终点 = 原生游标 + 词长[词元]
当(原生游标 < 原生终点) {
原生结果 = 原生结果 * 10 + (源[原生游标] - 48)
原生游标 = 原生游标 + 1
}
返回 原生结果
}
函数 原生查找全局(词元, 种类) {
整数 当前 = 读取节点左(程序节点 - 1)
当(当前 > 0) {
如果(节点种类[当前 - 1] == 种类) {
如果(原生记号相等(读取节点记号(当前 - 1), 词元) == 1) { 返回 当前 }
}
当前 = 读取节点后继(当前 - 1)
}
返回 0
}
函数 原生全局地址(编号) {
返回 原生数据基址 + 原生全局偏移低[编号] + 原生全局偏移高[编号] * 256 + 原生全局偏移更高[编号] * 65536
}
函数 原生分配全局() {
整数 当前 = 读取节点左(程序节点 - 1)
整数 编号 = 0
整数 种类 = 0
整数 长度 = 0
整数 长度记号 = 0
原生数据大小 = 0
当(当前 > 0) {
编号 = 当前 - 1
种类 = 节点种类[编号]
长度 = 0
如果(种类 == 40) { 长度 = 8 }
如果(种类 == 44) {
长度记号 = 读取节点左(编号) - 1
长度 = 原生解析整数(长度记号)
如果(长度 <= 0) { 返回 0 }
}
如果(长度 > 0) {
如果(长度 > 16777216 - 原生数据大小) { 返回 0 }
原生全局偏移低[编号] = 原生数据大小
原生全局偏移高[编号] = 原生数据大小 / 256
原生全局偏移更高[编号] = 原生数据大小 / 65536
原生数据大小 = 原生数据大小 + 长度
}
当前 = 读取节点后继(编号)
}
返回 1
}
函数 原生退出进程() {
如果(原生模式 == 2) {
# leave; pop r13; pop r12; ret，恢复 Windows 加载器的寄存器和栈。
暂存 = 原生追加整数(1096630729, 4)
返回 原生追加整数(50012, 2)
}
# mov rdi, rax; mov eax, 60; syscall
暂存 = 原生追加整数(3100084552, 4)
暂存 = 原生追加整数(60, 4)
返回 原生追加整数(1295, 2)
}
函数 原生短调用(入口) {
暂存 = 原生追加字节(232)
返回 原生追加整数(原生补32(入口 - 原生输出长度 - 4), 4)
}
函数 原生根帧入(槽) {
# lea rdx,[rbp-8*槽]
暂存 = 原生追加整数(9801032, 3)
暂存 = 原生追加整数(原生补32(0 - 8 * 槽), 4)
返回 原生短调用(原生根入入口)
}
函数 原生弹根(数量) {
如果(数量 == 0) { 返回 1 }
# mov edx,数量; 保持新的调用返回值 rax
暂存 = 原生追加字节(186)
暂存 = 原生追加整数(数量, 4)
返回 原生短调用(原生根弹入口)
}
函数 原生弹表达式(编号) {
如果(使用向量 == 1) { 暂存 = 原生弹根(向量表达式[编号]) }
返回 原生弹值()
}
函数 原生发射表达式(编号) {
如果(原生发射表达式核心(编号) == 0) { 返回 0 }
如果(使用向量 == 1) {
如果(向量表达式[编号] == 1) {
# mov rdx,rsp；孩子的临时根一直保留至消费点。
暂存 = 原生追加整数(14846280, 3)
暂存 = 原生短调用(原生根入入口)
}
}
返回 1
}
函数 原生发射启动任务(实参) {
# 第一个节点不是值表达式，而是编译期确定的白泽函数入口。
整数 目标 = 原生查找函数(读取节点记号(读取节点左(实参 - 1) - 1))
整数 坑 = 0
整数 参数 = 读取节点后继(实参 - 1)
如果(目标 == 0) { 返回 0 }
# lea rax,[rip+函数入口]；复用 rel32 调用坑，以同样的基准回填。
暂存 = 原生追加整数(363848, 3)
坑 = 原生输出长度
暂存 = 原生追加整数(0, 4)
如果(原生记调用坑(坑, 目标) == 0) { 返回 0 }
暂存 = 原生压值()
如果(原生发射表达式(读取节点左(参数 - 1) - 1) == 0) { 返回 0 }
暂存 = 原生短调用(原生启动任务入口)
# add rsp,16
暂存 = 原生追加整数(281314120, 4)
返回 原生压值()
}
函数 原生发射表达式核心(编号) {
整数 原生种类 = 0
