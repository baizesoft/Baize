函数 新节点(种类, 词元, 左, 右) {
如果(节点数 >= 65536) { 返回 0 }
节点种类[节点数] = 种类
节点记号低[节点数] = 词元 - (词元 / 256) * 256
节点记号高[节点数] = 词元 / 256
节点左低[节点数] = 左 - (左 / 256) * 256
节点左高[节点数] = 左 / 256
节点右低[节点数] = 右 - (右 / 256) * 256
节点右高[节点数] = 右 / 256
节点数 = 节点数 + 1
返回 节点数 - 1
}
函数 链接节点(前, 后) {
如果(前 > 0) {
节点后继低[前 - 1] = 后 - (后 / 256) * 256
节点后继高[前 - 1] = 后 / 256
}
返回 后
}
