函数 原生发射语句(编号) {
整数 原生种类 = 0
整数 原生词元 = 0
整数 原生左 = 0
整数 原生右 = 0
整数 原生槽 = 0
整数 原生否则块 = 0
整数 原生假坑 = 0
整数 原生结束坑 = 0
整数 原生目标 = 0
如果(编号 < 0) { 返回 0 }
如果(编号 >= 65536) { 返回 0 }
原生种类 = 节点种类[编号]
如果(原生种类 == 42) { 返回 原生发射输出(编号) }
如果(原生种类 == 52) {
原生左 = 读取节点左(编号) - 1
如果(原生发射表达式(原生左) == 0) { 返回 0 }
返回 原生弹表达式(原生左)
}
如果(原生种类 == 40) {
如果(原生顶层 * (原生块深度 == 0) == 1) { 返回 原生发射全局初始化(编号) }
如果(原生发射表达式(读取节点左(编号) - 1) == 0) { 返回 0 }
原生槽 = 原生加槽(读取节点记号(编号))
如果(原生槽 == 0) { 返回 0 }
暂存 = 原生弹表达式(读取节点左(编号) - 1)
暂存 = 原生存帧值(0 - 8 * 原生槽)
如果(使用向量 == 1) {
如果(节点静态类型[编号] == 5) { 暂存 = 原生根帧入(原生槽) }
}
返回 1
}
如果(原生种类 == 41) {
原生词元 = 读取节点记号(编号)
原生槽 = 原生查找槽(原生词元)
如果(原生槽 == 0) { 返回 原生发射全局初始化(编号) }
原生左 = 读取节点左(编号) - 1
如果(原生发射表达式(原生左) == 0) { 返回 0 }
暂存 = 原生弹表达式(原生左)
返回 原生存帧值(0 - 8 * 原生槽)
}
如果(原生种类 == 45) {
原生目标 = 原生查找全局(读取节点记号(编号), 44)
如果(原生目标 == 0) { 返回 0 }
如果(原生发射表达式(读取节点左(编号) - 1) == 0) { 返回 0 }
如果(原生发射表达式(读取节点右(编号) - 1) == 0) { 返回 0 }
暂存 = 原生弹值()
暂存 = 原生弹右()
# mov rdx, imm64; mov [rdx+rcx], al
暂存 = 原生追加整数(47688, 2)
暂存 = 原生追加整数(原生全局地址(原生目标 - 1), 8)
返回 原生追加整数(656520, 3)
}
如果(原生种类 == 43) {
原生左 = 读取节点左(编号) - 1
如果(原生发射表达式(原生左) == 0) { 返回 0 }
暂存 = 原生弹表达式(原生左)
如果(原生顶层 == 1) { 返回 原生退出进程() }
暂存 = 原生存帧值(0 - 原生返回偏移)
暂存 = 原生追加字节(233)
原生目标 = 原生输出长度
暂存 = 原生追加字节(0)
暂存 = 原生追加字节(0)
暂存 = 原生追加字节(0)
暂存 = 原生追加字节(0)
