如果(编号 >= 65536) { 返回 0 }
原生种类 = 节点种类[编号]
原生词元 = 读取节点记号(编号)
如果(原生种类 == 1) {
暂存 = 原生送立即(原生解析整数(原生词元))
暂存 = 原生压值()
返回 1
}
如果(原生种类 == 4) {
# 跳过以 NUL 结尾的 UTF-8 字面量，再把地址作为表达式值入栈。
暂存 = 原生追加字节(233)
整数 跨过字符串 = 原生输出长度
暂存 = 原生追加整数(0, 4)
整数 字符串位置 = 原生输出长度
