} 否则 {
如果(参数数量() == 5) {
暂存 = 表达式摘要()
} 否则 {
如果(参数数量() == 4) {
输出(解析程序())
} 否则 {
如果(参数数量() == 3) {
如果(原生模式 == 1) {
暂存 = 原生发射程序()
如果(原生退出码 == 1) {
输出("编译错误：原生后端暂不支持此程序")
返回 1
}
如果(原生退出码 == 2) {
输出("编译错误：无法写入 ELF 文件")
返回 1
}
输出(1)
} 否则 {
如果(程序解析模式 == 1) {
如果(解析程序() == 1) { 输出(发射程序()) } 否则 {
输出("编译错误：程序语法无效")
输出("源码行")
输出(解析错误行)
输出("UTF-8字节偏移")
输出(解析错误偏移)
输出(0)
}
} 否则 {
输出(验证表达式())
}
}
} 否则 {
如果(参数数量() == 2) {
输出游标 = 0
当(输出游标 < 记号数) {
输出(分类[输出游标])
输出(词长[输出游标])
切片游标 = 读取起点(输出游标)
切片终点 = 切片游标 + 词长[输出游标]
当(切片游标 < 切片终点) {
输出(源[切片游标])
切片游标 = 切片游标 + 1
}
输出游标 = 输出游标 + 1
}
} 否则 {
输出游标 = 0
当(输出游标 < 记号数) {
输出(分类[输出游标])
输出(词长[输出游标])
输出游标 = 输出游标 + 1

}
}
}
}
}
}
