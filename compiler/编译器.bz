如果(值 == 92) {
开始 = 开始 + 1
如果(开始 >= 结束) { 返回 0 }
值 = 源[开始]
如果(值 == 110) { 值 = 10 } 否则 {
如果(值 == 116) { 值 = 9 } 否则 {
如果(值 >= 128) { 返回 0 }
}
}
}
暂存 = 原生追加字节(值)
如果(暂存 == 0) { 返回 0 }
开始 = 开始 + 1
}
