# 静态模式由显式函数签名启用；在两个后端共用的 AST 上检查，不改变 ABI。
字节数组 静态局部低[64]
字节数组 静态局部高[64]
整数 静态局部数 = 0
整数 静态返回预期 = 1
整数 静态错误 = 0
函数 静态拒绝(码) {
静态错误 = 码
返回 0
}
函数 静态内置(名) {
整数 任务内置 = 任务内置编号(名)
如果(任务内置 != 0) { 返回 任务内置 }
如果(是新建字节向量(名) == 1) { 返回 5 }
如果(是向量长度(名) == 1) { 返回 6 }
如果(是向量读字节(名) == 1) { 返回 7 }
如果(是向量写字节(名) == 1) { 返回 8 }
如果(是错误输出字节(名) == 1) { 返回 4 }
如果(匹配词元12(名, 229, 143, 130, 230, 149, 176, 230, 149, 176, 233, 135, 143) == 1) { 返回 1 }
如果(匹配词元12(名, 229, 143, 130, 230, 149, 176, 232, 175, 187, 229, 143, 150) == 1) { 返回 2 }
如果(匹配词元12(名, 230, 150, 135, 228, 187, 182, 232, 175, 187, 229, 143, 150) == 1) { 返回 3 }
如果(匹配词元12(名, 230, 150, 135, 228, 187, 182, 229, 134, 153, 229, 133, 165) == 1) { 返回 3 }
返回 0
}
函数 静态查局部(名) {
整数 槽 = 0
整数 节点 = 0
当(槽 < 静态局部数) {
节点 = 静态局部低[槽] + 静态局部高[槽] * 256
如果(原生记号相等(读取节点记号(节点), 名) == 1) { 返回 节点静态类型[节点] }
槽 = 槽 + 1
}
返回 0
}
函数 静态查值(名) {
整数 类型 = 静态查局部(名)
整数 节点 = 0
如果(类型 != 0) { 返回 类型 }
节点 = 原生查找全局(名, 40)
如果(节点 > 0) { 返回 节点静态类型[节点 - 1] }
如果(原生查找全局(名, 44) > 0) { 返回 3 }
返回 0
}
函数 静态加局部(节点) {
如果(静态局部数 >= 64) { 返回 静态拒绝(7) }
如果(静态查值(读取节点记号(节点)) != 0) { 返回 静态拒绝(7) }
静态局部低[静态局部数] = 节点
静态局部高[静态局部数] = 节点 / 256
静态局部数 = 静态局部数 + 1
返回 1
}
函数 静态查函数(名) {
整数 项 = 读取节点左(程序节点 - 1)
当(项 > 0) {
如果(节点种类[项 - 1] == 49) {
如果(原生记号相等(读取节点记号(项 - 1), 名) == 1) { 返回 项 }
}
项 = 读取节点后继(项 - 1)
}
返回 0
}
函数 静态向量读写(实参, 预期元数) {
整数 号 = 0
整数 实型 = 0
整数 预期 = 0
当(实参 > 0) {
如果(号 >= 预期元数) { 返回 静态拒绝(1) }
预期 = 1
如果(号 == 0) { 预期 = 5 }
实型 = 静态表达式(读取节点左(实参 - 1) - 1)
如果(实型 == 0) { 返回 0 }
如果(实型 != 预期) { 返回 静态拒绝(1) }
实参 = 读取节点后继(实参 - 1)
号 = 号 + 1
}
如果(号 != 预期元数) { 返回 静态拒绝(1) }
返回 1
}
函数 静态核对启动任务(实参) {
整数 节点 = 0
整数 名 = 0
整数 入口 = 0
整数 形参 = 0
整数 参数 = 0
如果(实参 == 0) { 返回 静态拒绝(1) }
节点 = 读取节点左(实参 - 1) - 1
如果(节点种类[节点] != 2) { 返回 静态拒绝(11) }
名 = 读取节点记号(节点)
如果(静态查值(名) != 0) { 返回 静态拒绝(11) }
入口 = 静态查函数(名)
如果(入口 == 0) { 返回 静态拒绝(11) }
如果(节点静态类型[入口 - 1] != 1) { 返回 静态拒绝(11) }
形参 = 读取节点右(入口 - 1)
如果(形参 == 0) { 返回 静态拒绝(11) }
如果(读取节点后继(形参 - 1) != 0) { 返回 静态拒绝(11) }
如果(节点静态类型[形参 - 1] != 1) { 返回 静态拒绝(11) }
参数 = 读取节点后继(实参 - 1)
如果(参数 == 0) { 返回 静态拒绝(1) }
如果(读取节点后继(参数 - 1) != 0) { 返回 静态拒绝(1) }
整数 类型 = 静态表达式(读取节点左(参数 - 1) - 1)
如果(类型 == 0) { 返回 0 }
如果(类型 != 1) { 返回 静态拒绝(1) }
返回 1
}
函数 静态核对内置(内置, 实参) {
如果(内置 == 9) { 返回 静态核对启动任务(实参) }
如果(内置 == 10) {
如果(实参 != 0) { 返回 静态拒绝(1) }
返回 1
}
如果(内置 == 15) {
如果(实参 != 0) { 返回 静态拒绝(1) }
返回 1
}
如果(内置 == 13) {
整数 数量 = 0
当(实参 > 0) {
如果(数量 >= 2) { 返回 静态拒绝(1) }
整数 实型 = 静态表达式(读取节点左(实参 - 1) - 1)
如果(实型 == 0) { 返回 0 }
如果(实型 != 1) { 返回 静态拒绝(1) }
数量 = 数量 + 1
实参 = 读取节点后继(实参 - 1)
}
如果(数量 != 2) { 返回 静态拒绝(1) }
返回 1
}
如果(内置 == 7) { 返回 静态向量读写(实参, 2) }
如果(内置 == 8) { 返回 静态向量读写(实参, 3) }
如果(内置 >= 4) {
如果(实参 == 0) { 返回 静态拒绝(1) }
如果(读取节点后继(实参 - 1) != 0) { 返回 静态拒绝(1) }
整数 字节类型 = 静态表达式(读取节点左(实参 - 1) - 1)
如果(字节类型 == 0) { 返回 0 }
如果(内置 == 6) {
如果(字节类型 != 5) { 返回 静态拒绝(1) }
返回 1
}
如果(字节类型 != 1) { 返回 静态拒绝(1) }
如果(内置 == 5) { 返回 5 }
返回 1
}
整数 号 = 0
整数 类型 = 0
整数 预期 = 0
当(实参 > 0) {
如果(内置 == 1) { 返回 静态拒绝(1) }
如果(号 >= 3) { 返回 静态拒绝(1) }
预期 = 1
如果(号 == 1) { 预期 = 3 }
如果(号 == 0) { 如果(内置 == 3) { 预期 = 4 } }
类型 = 静态表达式(读取节点左(实参 - 1) - 1)
如果(类型 == 0) { 返回 0 }
如果(类型 != 预期) {
如果(预期 != 4) { 返回 静态拒绝(1) }
如果(类型 != 3) { 返回 静态拒绝(1) }
}
实参 = 读取节点后继(实参 - 1)
号 = 号 + 1
