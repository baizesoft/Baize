如果(原生目标 == 0) { 返回 0 }
如果(原生发射表达式(读取节点左(编号) - 1) == 0) { 返回 0 }
暂存 = 原生弹右()
暂存 = 原生送立即(原生全局地址(原生目标 - 1))
# movzx eax, byte [rax+rcx]
暂存 = 原生追加整数(134526479, 4)
