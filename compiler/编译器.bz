暂存 = 原生追加字节(57)
暂存 = 原生追加字节(200)
整数 原生比较码 = 0
如果(原生运算 == 25) { 原生比较码 = 156 }
如果(原生运算 == 26) { 原生比较码 = 159 }
如果(原生运算 == 6) {
