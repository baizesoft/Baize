函数 百分比乘积(左, 右, 层数) {
# 去掉定点刻度后仍有两个分段。逐层除以 100，再检查结果范围。
整数 甲 = 绝对值(左)
整数 乙 = 绝对值(右)
整数 甲高 = 甲 / 倍率
整数 乙高 = 乙 / 倍率
整数 甲低 = 甲 - 甲高 * 倍率
整数 乙低 = 乙 - 乙高 * 倍率
整数 中间 = 甲高 * 乙低 + 乙高 * 甲低 + 甲低 * 乙低 / 倍率
整数 高段 = 甲高 * 乙高 + 中间 / 倍率
整数 低段 = 中间 - 中间 / 倍率 * 倍率
当(层数 > 0) {
整数 高商 = 高段 / 100
低段 = ((高段 - 高商 * 100) * 倍率 + 低段) / 100
高段 = 高商
层数 = 层数 - 1
}
如果(高段 > (上限 - 低段) / 倍率) { 错误 = 3
返回 0 }
返回 合成符号(高段 * 倍率 + 低段, 左, 右)
}

