如果(单位 < 1) { 返回 0 }
如果(单位 <= 8) { 返回 1 }
如果(单位 <= 11) { 返回 2 }
如果(单位 <= 17) { 返回 3 }
如果(单位 <= 21) { 返回 4 }
如果(单位 <= 28) { 返回 5 }
如果(单位 <= 38) { 返回 6 }
如果(单位 <= 47) { 返回 7 }
如果(单位 <= 55) { 返回 8 }
如果(单位 <= 62) { 返回 9 }
如果(单位 <= 69) { 返回 10 }
如果(单位 <= 74) { 返回 11 }
如果(单位 <= 79) { 返回 12 }
如果(单位 <= 85) { 返回 13 }
如果(单位 <= 89) { 返回 14 }
如果(单位 <= 100) { 返回 15 }
如果(单位 <= 105) { 返回 16 }
如果(单位 <= 110) { 返回 17 }
如果(单位 <= 115) { 返回 18 }
返回 0
}

函数 单位系数(单位, 类别) {
如果(类别 == 1) { 返回 长度系数(单位) }
# 质量以纳克表示，精确包含常衡磅和盎司。
如果(单位 == 12) { 返回 1000000 }
如果(单位 == 13) { 返回 1000000000 }
如果(单位 == 14) { 返回 1000000000000 }
如果(单位 == 15) { 返回 453592370000 }
如果(单位 == 16) { 返回 28349523125 }
如果(单位 == 17) { 返回 500000000000 }
# 速度以九百万分之一米每秒表示。
如果(单位 == 18) { 返回 9000000 }
如果(单位 == 19) { 返回 2500000 }
如果(单位 == 20) { 返回 4023360 }
如果(单位 == 21) { 返回 4630000 }
# 时间以毫秒表示。天和周在这里是固定时长。
如果(单位 == 22) { 返回 1 }
如果(单位 == 23) { 返回 1000 }
如果(单位 == 24) { 返回 60000 }
如果(单位 == 25) { 返回 3600000 }
如果(单位 == 26) { 返回 86400000 }
如果(单位 == 27) { 返回 604800000 }
如果(单位 == 28) { 返回 1000 * 60 * 60 * 24 * 365 }
# 容量以位表示，十进制前缀按 1000，二进制前缀按 1024。
如果(单位 == 29) { 返回 1 }
如果(单位 == 30) { 返回 8 }
如果(单位 == 31) { 返回 8000 }
如果(单位 == 32) { 返回 8000000 }
如果(单位 == 33) { 返回 8000000000 }
如果(单位 == 34) { 返回 8000000000000 }
如果(单位 == 35) { 返回 8192 }
如果(单位 == 36) { 返回 8388608 }
如果(单位 == 37) { 返回 8589934592 }
如果(单位 == 38) { 返回 8796093022208 }
# 面积以三亿分之一平方米表示，1 市亩精确等于 2000/3 平方米。
如果(单位 == 39) { 返回 30000 }
如果(单位 == 40) { 返回 300000000 }
如果(单位 == 41) { 返回 3000000000000 }
如果(单位 == 42) { 返回 300000000000000 }
如果(单位 == 43) { 返回 200000000000 }
如果(单位 == 44) { 返回 193548 }
如果(单位 == 45) { 返回 27870912 }
如果(单位 == 46) { 返回 250838208 }
如果(单位 == 47) { 返回 1214056926720 }
# 体积以十万亿分之一升表示，精确包含美制液量盎司。
如果(单位 == 48) { 返回 10000000000 }
如果(单位 == 49) { 返回 10000000000000 }
如果(单位 == 50) { 返回 10000000000000000 }
如果(单位 == 51) { 返回 37854117840000 }
如果(单位 == 52) { 返回 45460900000000 }
如果(单位 == 53) { 返回 2365882365000 }
如果(单位 == 54) { 返回 295735295625 }
如果(单位 == 55) { 返回 284130625000 }
# 以 24516080000 分之一帕为单位，可精确表示 PSI 和托。
如果(单位 == 56) { 返回 24516080000 }
如果(单位 == 57) { 返回 24516080000000 }
如果(单位 == 58) { 返回 24516080000000000 }
如果(单位 == 59) { 返回 2451608000000000 }
如果(单位 == 60) { 返回 2484091806000000 }
如果(单位 == 61) { 返回 169032421379899 }
如果(单位 == 62) { 返回 3268541850000 }
# 能量以毫焦表示。热化学卡严格等于 4.184 焦。
如果(单位 == 63) { 返回 1000 }
如果(单位 == 64) { 返回 1000000 }
如果(单位 == 65) { 返回 1000000000 }
如果(单位 == 66) { 返回 3600000 }
如果(单位 == 67) { 返回 3600000000 }
如果(单位 == 68) { 返回 4184 }
如果(单位 == 69) { 返回 4184000 }
# 功率以皮瓦表示。机械马力系数舍入到皮瓦，公制马力严格等于 735.49875 瓦。
如果(单位 == 70) { 返回 1000000000000 }
如果(单位 == 71) { 返回 1000000000000000 }
如果(单位 == 72) { 返回 1000000000000000000 }
如果(单位 == 73) { 返回 745699871582270 }
如果(单位 == 74) { 返回 735498750000000 }
# 频率以每分钟的周期数表示，因此 RPM 到 Hz 的 1/60 比例不依赖近似常量。
如果(单位 == 75) { 返回 60 }
如果(单位 == 76) { 返回 60000 }
如果(单位 == 77) { 返回 60000000 }
如果(单位 == 78) { 返回 60000000000 }
如果(单位 == 79) { 返回 1 }
# 角度以百亿分之一角秒表示。只有弧度系数需要由圆周率近似。
如果(单位 == 80) { 返回 36000000000000 }
