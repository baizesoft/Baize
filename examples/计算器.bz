返回 值
}

函数 分段乘法(左, 右, 分段, 除数) {
# 分段平方是除数的整数倍。先计算可直接整除的高位，再合并尾数。
整数 甲 = 绝对值(左)
整数 乙 = 绝对值(右)
整数 甲高 = 甲 / 分段
整数 乙高 = 乙 / 分段
整数 甲低 = 甲 - 甲高 * 分段
整数 乙低 = 乙 - 乙高 * 分段
整数 除段 = 除数 / 分段
整数 高位系数 = 分段 / 除段
如果(乙高 != 0) {
如果(甲高 > 上限 / 高位系数 / 乙高) {
错误 = 3
返回 0
}
}
整数 值 = 甲高 * 乙高 * 高位系数 + (甲高 * 乙低 + 乙高 * 甲低 + (甲低 * 乙低) / 分段) / 除段
返回 检查范围(合成符号(值, 左, 右))
}

函数 乘法(左, 右) {
返回 分段乘法(左, 右, 分段基数, 倍率)
}

函数 除法(左, 右) {
返回 扩展除法(左, 右, 0)
}

函数 扩展除法(左, 右, 额外位数) {
如果(右 == 0) {
错误 = 2
返回 0
}
整数 甲 = 绝对值(左)
整数 乙 = 绝对值(右)
整数 值 = 甲 / 乙
整数 余数 = 甲 - 值 * 乙
整数 权重 = 倍率
整数 数字 = 0
整数 新余数 = 0
整数 补数 = 0
整数 次数 = 0
如果(值 > 上限 / 倍率) {
错误 = 3
返回 0
}
当((权重 > 1) + (额外位数 > 0) > 0) {
如果(余数 <= 922337203685477580) {
整数 扩展余数 = 余数 * 10
数字 = 扩展余数 / 乙
余数 = 扩展余数 - 数字 * 乙
} 否则 {
# 余数乘十会超出有符号 64 位时，在模除数的范围内累加。
新余数 = 0
数字 = 0
次数 = 0
补数 = 乙 - 余数
当(次数 < 10) {
如果(新余数 >= 补数) {
新余数 = 新余数 - 补数
数字 = 数字 + 1
} 否则 {
新余数 = 新余数 + 余数
}
次数 = 次数 + 1
}
余数 = 新余数
}
如果(值 > (上限 - 数字) / 10) {
错误 = 3
返回 0
}
值 = 值 * 10 + 数字
如果(权重 > 1) { 权重 = 权重 / 10 } 否则 { 额外位数 = 额外位数 - 1 }
}
返回 合成符号(值, 左, 右)
}

