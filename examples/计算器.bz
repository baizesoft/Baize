如果(单位 == 97) { 返回 8000000000 }
如果(单位 == 98) { 返回 8192 }
如果(单位 == 99) { 返回 8388608 }
如果(单位 == 100) { 返回 8589934592 }
# 加速度单位保留五位换算系数，标准重力加速度定义为 9.80665 m/s²。
如果(单位 == 101) { 返回 100000 }
如果(单位 == 102) { 返回 1000 }
如果(单位 == 103) { 返回 100 }
如果(单位 == 104) { 返回 30480 }
如果(单位 == 105) { 返回 980665 }
# 力以十万亿分之一牛顿表示，可精确换算磅力。
如果(单位 == 106) { 返回 10000000000000 }
如果(单位 == 107) { 返回 10000000000000000 }
如果(单位 == 108) { 返回 100000000 }
如果(单位 == 109) { 返回 98066500000000 }
如果(单位 == 110) { 返回 44482216152605 }
# 扭矩以 10^-16 牛顿米表示，磅力英寸和英尺来自磅力乘以精确长度。
如果(单位 == 111) { 返回 10000000000000000 }
如果(单位 == 112) { 返回 100000000000000 }
如果(单位 == 113) { 返回 98066500000000000 }
如果(单位 == 114) { 返回 13558179483314004 }
如果(单位 == 115) { 返回 1129848290276167 }
返回 0
}

函数 舍入尾商(余数, 分子, 分母) {
整数 小商 = 0
整数 尾数 = 0
如果(余数 <= 上限 / 分子) {
尾数 = 余数 * 分子
小商 = 尾数 / 分母
尾数 = 尾数 - 小商 * 分母
} 否则 {
# 逐位计算乘积的商和余数。每步余数小于分母，避免形成完整乘积。
整数 位 = 1
当(位 <= 分子 / 2) { 位 = 位 * 2 }
当(位 > 0) {
尾数 = 尾数 * 2
小商 = 小商 * 2
如果(分子 >= 位) {
分子 = 分子 - 位
尾数 = 尾数 + 余数
}
整数 进位 = 尾数 / 分母
小商 = 小商 + 进位
尾数 = 尾数 - 进位 * 分母
位 = 位 / 2
}
}
如果(尾数 * 2 >= 分母) { 小商 = 小商 + 1 }
返回 小商
}

函数 比例换算(值, 分子, 分母) {
如果(分子 == 0) { 返回 0 }
整数 幅值 = 绝对值(值)
整数 商 = 幅值 / 分母
如果(商 > 上限 / 分子) { 错误 = 3
返回 0 }
整数 小商 = 舍入尾商(幅值 - 商 * 分母, 分子, 分母)
整数 大商 = 商 * 分子
如果(小商 > 上限 - 大商) { 错误 = 3
返回 0 }
返回 合成符号(大商 + 小商, 值, 1)
}

函数 温度换算(值, 来源, 目标, 降位) {
# 摄氏度 = (输入 - 偏移) * 分子 / 分母，开尔文偏移已经用定点表示。
整数 分子 = 1
整数 分母 = 1
如果(来源 == 9) { 值 = 值 - 32000000000
分子 = 5
分母 = 9 }
如果(来源 == 10) { 值 = 值 - 273150000000 }
如果(目标 == 9) {
# 把目标偏移放进同一个分子，以便负数中点也按最终结果的符号舍入。
返回 比例换算(值 * 分子 * 9 + 32000000000 * 分母 * 5, 1, 分母 * 5 * 降位)
}
如果(目标 == 10) {
返回 比例换算(值 * 分子 + 273150000000 * 分母, 1, 分母 * 降位)
}
返回 比例换算(值, 分子, 分母 * 降位)
}

函数 油耗里程系数(单位) {
如果(单位 == 88) { 返回 3785411784 }
如果(单位 == 89) { 返回 4546090000 }
返回 1609344000
}

函数 油耗换算(值, 来源, 目标, 降位) {
如果(来源 == 目标) { 返回 比例换算(值, 1, 降位) }
如果(来源 != 86) {
如果(目标 != 86) {
返回 比例换算(值, 油耗里程系数(目标), 油耗里程系数(来源) * 降位)
}
}
整数 里程单位 = 目标
如果(目标 == 86) { 里程单位 = 来源 }
# 往返的倒数系数预先放大 10^16，并舍入到最近的整数。
整数 系数 = 1000000000000000000
如果(里程单位 == 88) { 系数 = 2352145833333333333 }
如果(里程单位 == 89) { 系数 = 2824809363318221586 }
返回 比例换算(系数, 降位, 值)
}

