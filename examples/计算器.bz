上限 = 9223372036854775807
如果(类别 == 14) {
如果(值 <= 0) {
输出("换算错误：油耗需要正数")
返回 1
}
}
如果(全部 == 1) {
当(单位类别(目标 - 1) == 类别) { 目标 = 目标 - 1 }
当(单位类别(目标) == 类别) {
错误 = 0
整数 结果值 = 换算单位值(值, 来源, 目标, 类别, 10)
如果(写十进制行(错误, 1) != 0) { 返回 1 }
如果(写换算结果(结果值, 文本, 值, 来源, 目标, 类别) != 0) { 返回 1 }
目标 = 目标 + 1
}
返回 输出刷新() != 0
}
