如果(单位 == 103) { 返回 200 }
返回 180
}

函数 计算三角值(角, 操作, 单位, 输出倍率) {
整数 绝对角 = 绝对值(角)
整数 余弦符号 = 1
整数 周期 = 圆周率 * 2
整数 半周 = 圆周率
整数 直角 = 圆周率 / 2
如果(单位 != 114) {
半周 = 半周角度单位(单位) * 1000000000
周期 = 半周 * 2
直角 = 半周 / 2
} 否则 {
如果(绝对角 > 100000000000) {
错误 = 7
返回 0
}
绝对角 = 绝对角 * 10000000
}
绝对角 = 绝对角 - 绝对角 / 周期 * 周期
整数 正弦符号 = 1
如果(角 < 0) { 正弦符号 = -1 }
如果(绝对角 > 半周) {
绝对角 = 周期 - 绝对角
正弦符号 = -正弦符号
}
如果(绝对角 > 直角) {
绝对角 = 半周 - 绝对角
余弦符号 = -1
