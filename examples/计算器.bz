函数 换算单位值(值, 来源, 目标, 类别, 降位) {
如果(来源 == 目标) { 返回 比例换算(值, 1, 降位) }
如果(类别 == 2) { 返回 温度换算(值, 来源, 目标, 降位) }
如果(类别 == 14) { 返回 油耗换算(值, 来源, 目标, 降位) }
整数 分子 = 单位系数(来源, 类别)
整数 分母 = 单位系数(目标, 类别)
# 能约去输入与输出刻度的 10 倍差时，先约分，避免放大兆瓦等大系数。
整数 约分分子 = 分子 / 降位
如果(约分分子 * 降位 == 分子) { 返回 比例换算(值, 约分分子, 分母) }
返回 比例换算(值, 分子, 分母 * 降位)
}

# 公历 0001-01-01 的序号为 1。
函数 公历闰年(年) {
如果(年 == 年 / 400 * 400) { 返回 1 }
如果(年 == 年 / 100 * 100) { 返回 0 }
返回 年 == 年 / 4 * 4
}

函数 公历月天数(年, 月) {
如果(月 == 2) { 返回 28 + 公历闰年(年) }
如果(月 == 4) { 返回 30 }
如果(月 == 6) { 返回 30 }
如果(月 == 9) { 返回 30 }
如果(月 == 11) { 返回 30 }
返回 31
}

函数 年前天数(年) {
整数 前年 = 年 - 1
返回 前年 * 365 + 前年 / 4 - 前年 / 100 + 前年 / 400
}

函数 读日期序号(参数索引) {
如果(参数读取(参数索引, 程序输入, 66) != 8) { 返回 0 }
返回 解析日期序号(0)
}

函数 解析日期序号(起点) {
整数 日期 = 0
整数 日期下标 = 0
当(日期下标 < 8) {
整数 数字字节 = 程序输入[起点 + 日期下标]
如果(是数字(数字字节) == 0) { 返回 0 }
日期 = 日期 * 10 + 数字字节 - 48
日期下标 = 日期下标 + 1
}
整数 年 = 日期 / 10000
整数 月 = 日期 / 100 - 年 * 100
整数 日 = 日期 - 日期 / 100 * 100
如果(年 < 1) { 返回 0 }
如果(月 < 1) { 返回 0 }
如果(月 > 12) { 返回 0 }
如果(日 < 1) { 返回 0 }
如果(日 > 公历月天数(年, 月)) { 返回 0 }
返回 日期序号(年, 月, 日)
}

函数 日期序号(年, 月, 日) {
整数 序号 = 年前天数(年) + 日
当(月 > 1) {
月 = 月 - 1
序号 = 序号 + 公历月天数(年, 月)
}
返回 序号
}

函数 序号转日期(序号) {
整数 下界 = 1
整数 上界 = 10000
当(上界 - 下界 > 1) {
整数 中间 = (下界 + 上界) / 2
如果(年前天数(中间) < 序号) { 下界 = 中间 } 否则 { 上界 = 中间 }
}
整数 年内 = 序号 - 年前天数(下界)
整数 月 = 1
当(年内 > 公历月天数(下界, 月)) {
年内 = 年内 - 公历月天数(下界, 月)
月 = 月 + 1
}
返回 下界 * 10000 + 月 * 100 + 年内
}

