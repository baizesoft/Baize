# 公历序号 1 是星期一。完整一周贡献五个工作日。
函数 累计工作日(序号) {
整数 完整周 = 序号 / 7
整数 剩余 = 序号 - 完整周 * 7
如果(剩余 > 5) { 剩余 = 5 }
整数 工作日合计 = 完整周 * 5 + 剩余
整数 索引 = 0
当(索引 < 工作日例外数) {
整数 例外序号 = 工作日例外日期(索引)
如果(例外序号 <= 序号) {
整数 偏移 = 例外序号 - 1
整数 本是工作日 = 偏移 - 偏移 / 7 * 7 < 5
整数 改为工作日 = 工作日例外[索引 * 4 + 3] == 43
工作日合计 = 工作日合计 + 改为工作日 - 本是工作日
}
索引 = 索引 + 1
}
返回 工作日合计
}

函数 移动工作日(起日, 天数) {
如果(天数 == 0) { 返回 输出有效日期(起日) }
整数 目标 = 累计工作日(起日) + 天数
如果(天数 < 0) { 目标 = 累计工作日(起日 - 1) + 天数 + 1 }
整数 下界 = 1
整数 上界 = 年前天数(10000)
如果(目标 < 1) { 返回 日期越界错误() }
如果(目标 > 累计工作日(上界)) { 返回 日期越界错误() }
# 累计量在周末持平，取最早达到目标的日期即可落在工作日。
当(下界 < 上界) {
整数 中点 = (下界 + 上界) / 2
如果(累计工作日(中点) < 目标) { 下界 = 中点 + 1 } 否则 { 上界 = 中点 }
}
返回 输出有效日期(下界)
}

