整数 左 = 0
整数 右 = 上限
整数 中点 = 0
当(左 < 右) {
中点 = 左 + (右 - 左 + 1) / 2
如果(平方不超过(中点, 值) == 1) {
左 = 中点
} 否则 {
右 = 中点 - 1
}
}
返回 左
}

