# 程序员模式按所选字长解释无符号位串。同一位串的多种进制由宿主显示。
字节数组 程序模式[16]
字节数组 程序输入[322]
整数 程序字长 = 32
整数 程序输入错误 = 0
整数 DWORD上限 = 4294967295

函数 是程序员模式() {
如果(参数数量() < 1) { 返回 0 }
如果(参数读取(0, 程序模式, 14) != 12) { 返回 0 }
如果(程序模式[0] != 45) { 返回 0 }
如果(程序模式[1] != 45) { 返回 0 }
如果(程序模式[2] != 112) { 返回 0 }
如果(程序模式[3] != 114) { 返回 0 }
如果(程序模式[4] != 111) { 返回 0 }
如果(程序模式[5] != 103) { 返回 0 }
如果(程序模式[6] != 114) { 返回 0 }
如果(程序模式[7] != 97) { 返回 0 }
如果(程序模式[8] != 109) { 返回 0 }
如果(程序模式[9] != 109) { 返回 0 }
如果(程序模式[10] != 101) { 返回 0 }
返回 程序模式[11] == 114
}

函数 进制数字(字节) {
如果(是数字(字节) == 1) { 返回 字节 - 48 }
如果(字节 >= 65) {
如果(字节 <= 70) { 返回 字节 - 55 }
}
如果(字节 >= 97) {
如果(字节 <= 102) { 返回 字节 - 87 }
}
返回 -1
}

函数 字长掩码(位宽) {
如果(位宽 == 64) { 返回 -1 }
返回 逻辑左移(1, 位宽) - 1
}

函数 读取程序数(索引, 基数, 位宽) {
整数 数量 = 参数读取(索引, 程序输入, 66)
返回 解析程序数(数量, 0, 基数, 位宽)
}

函数 解析程序数(数量, 位置, 基数, 位宽) {
整数 数字 = 0
整数 低部 = 0
整数 高部 = 0
整数 进位 = 0
程序输入错误 = 1
如果(数量 <= 位置) { 返回 0 }
如果(数量 > 64) { 返回 0 }
# 采用两个 32 位分段累积。全宽 QWORD 的高位在最后才按位组装。
当(位置 < 数量) {
数字 = 进制数字(程序输入[位置])
如果(数字 < 0) { 返回 0 }
如果(数字 >= 基数) { 返回 0 }
低部 = 低部 * 基数 + 数字
进位 = 逻辑右移(低部, 32)
低部 = 整数位与(低部, DWORD上限)
高部 = 高部 * 基数 + 进位
如果(高部 > DWORD上限) { 返回 0 }
位置 = 位置 + 1
}
如果(位宽 < 64) {
如果(高部 != 0) { 返回 0 }
如果(低部 > 字长掩码(位宽)) { 返回 0 }
}
程序输入错误 = 0
返回 整数位或(逻辑左移(高部, 32), 低部)
}

函数 程序操作数起点(数量, 基数) {
如果(数量 < 2) { 返回 0 }
如果(程序输入[0] != 48) { 返回 0 }
整数 前缀 = 0
如果(基数 == 2) { 前缀 = 98 }
如果(基数 == 8) { 前缀 = 111 }
如果(基数 == 16) { 前缀 = 120 }
如果(前缀 == 0) { 返回 0 }
如果(程序输入[1] == 前缀) { 返回 2 }
如果(程序输入[1] == 前缀 - 32) { 返回 2 }
返回 0
}

函数 去除程序数字分隔符(数量, 起点) {
整数 写位 = 0
整数 读位 = 起点
整数 前项是数字 = 0
当(读位 < 数量) {
整数 字节 = 程序输入[读位]
如果(字节 == 95) {
如果(前项是数字 == 0) { 返回 0 }
前项是数字 = 0
} 否则 {
如果(进制数字(字节) < 0) { 返回 0 }
程序输入[写位] = 字节
写位 = 写位 + 1
前项是数字 = 1
}
读位 = 读位 + 1
}
如果(前项是数字 == 0) { 返回 0 }
返回 写位
}

函数 读取程序操作数(索引, 基数) {
整数 数量 = 参数读取(索引, 程序输入, 131)
返回 解析程序操作数(数量, 基数)
}

函数 解析程序操作数(数量, 基数) {
程序输入错误 = 1
如果(数量 <= 0) { 返回 0 }
如果(数量 > 129) { 返回 0 }
整数 起点 = 程序操作数起点(数量, 基数)
整数 负数 = 0
如果(基数 == 10) {
如果(程序输入[0] == 45) {
负数 = 1
起点 = 1
}
}
数量 = 去除程序数字分隔符(数量, 起点)
如果(负数 == 1) {
整数 幅值 = 解析程序数(数量, 0, 10, 程序字长)
整数 符号位 = 逻辑左移(1, 程序字长 - 1)
如果(无符号不小于(符号位, 幅值) == 0) { 程序输入错误 = 1 }
如果(程序输入错误 != 0) { 返回 0 }
返回 字长加减(0, 45, 幅值)
}
返回 解析程序数(数量, 0, 基数, 程序字长)
}

函数 字长加减(左, 操作, 右) {
整数 进位 = 0
如果(操作 == 45) { 右 = 整数位反(右)
进位 = 1 }
# 加法在两个 32 位分段里完成，减法用补码加法。
整数 低位和 = 整数位与(左, DWORD上限) + 整数位与(右, DWORD上限) + 进位
整数 高位和 = 逻辑右移(左, 32) + 逻辑右移(右, 32) + 逻辑右移(低位和, 32)
整数 位串 = 整数位或(逻辑左移(高位和, 32), 整数位与(低位和, DWORD上限))
返回 整数位与(位串, 字长掩码(程序字长))
}

函数 字长乘法(左, 右) {
整数 乘积 = 0
当(右 != 0) {
如果(整数位与(右, 1) == 1) { 乘积 = 字长加减(乘积, 43, 左) }
左 = 逻辑左移(左, 1)
右 = 逻辑右移(右, 1)
}
返回 乘积
}

函数 无符号不小于(左, 右) {
如果(左 < 0) {
如果(右 >= 0) { 返回 1 }
} 否则 {
如果(右 < 0) { 返回 0 }
}
返回 左 >= 右
}

函数 字长除法(被除数, 除数, 取余) {
整数 商 = 0
整数 余数 = 0
整数 位数 = 程序字长
当(位数 > 0) {
位数 = 位数 - 1
# 左移前最多已读取 63 位，余数不会占满 64 位。
整数 下一位 = 整数位与(逻辑右移(被除数, 位数), 1)
余数 = 整数位或(逻辑左移(余数, 1), 下一位)
如果(无符号不小于(余数, 除数) == 1) {
余数 = 字长加减(余数, 45, 除数)
商 = 整数位或(商, 逻辑左移(1, 位数))
}
}
如果(取余 == 1) { 返回 余数 }
返回 商
}

函数 运行字长除法(左, 右, 操作) {
如果(右 == 0) {
输出("程序员错误：除数不能为零")
返回 1
}
整数 取余 = 操作 == 37
如果(操作 == 77) { 取余 = 1 }
整数 有符号 = 操作 == 68
如果(操作 == 77) { 有符号 = 1 }
整数 结果为负 = 0
如果(有符号 == 1) {
整数 符号位 = 逻辑左移(1, 程序字长 - 1)
如果(取余 == 0) {
如果(左 == 符号位) {
如果(右 == 字长掩码(程序字长)) {
输出("程序员错误：有符号商超出所选字长")
返回 1
}
}
}
整数 左负 = 整数位与(左, 符号位) != 0
整数 右负 = 整数位与(右, 符号位) != 0
结果为负 = 左负
如果(取余 == 0) { 结果为负 = 左负 != 右负 }
如果(左负 == 1) { 左 = 字长加减(0, 45, 左) }
如果(右负 == 1) { 右 = 字长加减(0, 45, 右) }
}
整数 除法结果 = 字长除法(左, 右, 取余)
如果(结果为负 == 1) { 除法结果 = 字长加减(0, 45, 除法结果) }
输出(除法结果)
返回 0
}

函数 位运算(左, 操作, 右) {
如果(操作 == 97) { 返回 整数位与(左, 右) }
如果(操作 == 111) { 返回 整数位或(左, 右) }
返回 整数位异(左, 右)
}

函数 逻辑移位(值, 操作, 位数) {
如果(操作 == 108) {
返回 整数位与(逻辑左移(值, 位数), 字长掩码(程序字长))
}
如果(操作 == 114) { 返回 逻辑右移(值, 位数) }
如果(操作 == 104) {
整数 移后 = 逻辑右移(值, 位数)
如果(逻辑右移(值, 程序字长 - 1) == 0) { 返回 移后 }
整数 掩码 = 字长掩码(程序字长)
整数 符号填充 = 整数位异(掩码, 逻辑右移(掩码, 位数))
返回 整数位或(移后, 符号填充)
}
如果(位数 == 0) { 返回 值 }
整数 左移数 = 位数
如果(操作 == 82) { 左移数 = 程序字长 - 位数 }
整数 回绕 = 逻辑右移(值, 程序字长 - 左移数)
返回 整数位与(整数位或(逻辑左移(值, 左移数), 回绕), 字长掩码(程序字长))
}

