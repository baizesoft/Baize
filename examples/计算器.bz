整数 右值 = 0
当(错误 == 0) {
如果(运算 == 42) { 游标 = 游标 + 1 } 否则 {
如果(运算 == 47) { 游标 = 游标 + 1 } 否则 {
如果(绘图模式 + 完整算式模式 == 0) { 返回 值 }
如果(是省略乘号(运算) == 0) { 返回 值 }
运算 = 42
}
}
右值 = 解析因子()
如果(错误 != 0) { 返回 0 }
如果(仅校验语法 == 0) {
整数 层数 = 0
如果(完整算式模式 == 1) { 层数 = 解析百分比操作数层数() }
如果(运算 == 42) {
如果(层数 == 0) { 值 = 乘法(值, 右值) } 否则 {
值 = 百分比乘积(值, 右值, 层数)
}
} 否则 {
值 = 扩展除法(值, 右值, 层数 * 2)
}
}
运算 = 看符号()
}
返回 值
}

函数 解析和() {
整数 值 = 解析积(1)
整数 运算 = 看符号()
整数 右值 = 0
当(错误 == 0) {
如果(运算 != 43) {
如果(运算 != 45) { 返回 值 }
}
