如果(操作 == 68) { 返回 运行字长除法(左值, 右值, 操作) }
如果(操作 == 77) { 返回 运行字长除法(左值, 右值, 操作) }
如果(操作 == 113) { 输出(统计置位(整数位异(左值, 右值)))
返回 0 }
输出(位运算(左值, 操作, 右值))
返回 0
}

函数 统计置位(值) {
整数 置位数 = 0
当(值 != 0) {
置位数 = 置位数 + 整数位与(值, 1)
值 = 逻辑右移(值, 1)
}
返回 置位数
}

函数 统计边缘零位(值, 从高位) {
如果(值 == 0) { 返回 程序字长 }
整数 零位数 = 0
整数 位序 = 0
整数 步进 = 1
如果(从高位 == 1) {
位序 = 程序字长 - 1
步进 = -1
}
当(整数位与(逻辑右移(值, 位序), 1) == 0) {
零位数 = 零位数 + 1
位序 = 位序 + 步进
}
返回 零位数
}

函数 反转分组位序(值, 组宽) {
整数 剩余分组 = 程序字长 / 组宽
整数 分组掩码 = 字长掩码(组宽)
整数 结果 = 0
当(剩余分组 > 0) {
结果 = 整数位或(逻辑左移(结果, 组宽), 整数位与(值, 分组掩码))
值 = 逻辑右移(值, 组宽)
剩余分组 = 剩余分组 - 1
}
返回 结果
}

函数 位字段范围错误() {
输出("程序员错误：位字段须写为十进制起点:长度，且位于所选字长内")
返回 1
}

函数 解析位字段范围(字节数) {
如果(字节数 < 3) { 返回 -1 }
如果(字节数 > 64) { 返回 -1 }
整数 分隔点 = 0
当(分隔点 < 字节数) {
如果(程序输入[分隔点] == 58) {
整数 起始位 = 解析程序数(分隔点, 0, 10, 32)
如果(程序输入错误 != 0) { 返回 -1 }
整数 字段宽度 = 解析程序数(字节数, 分隔点 + 1, 10, 32)
如果(程序输入错误 != 0) { 返回 -1 }
如果(字段宽度 == 0) { 返回 -1 }
如果(起始位 + 字段宽度 > 程序字长) { 返回 -1 }
返回 起始位 * 64 + 字段宽度 - 1
}
分隔点 = 分隔点 + 1
}
返回 -1
}

函数 提取位字段(左值, 有符号字段) {
整数 范围 = 解析位字段范围(参数读取(4, 程序输入, 66))
如果(范围 < 0) { 返回 位字段范围错误() }
整数 起始位 = 范围 / 64
整数 字段宽度 = 范围 - 起始位 * 64 + 1
整数 字段掩码 = 字长掩码(字段宽度)
整数 字段位串 = 整数位与(逻辑右移(左值, 起始位), 字段掩码)
如果(有符号字段 == 1) {
如果(整数位与(逻辑右移(字段位串, 字段宽度 - 1), 1) == 1) {
整数 高位掩码 = 整数位异(字长掩码(程序字长), 字段掩码)
字段位串 = 整数位或(字段位串, 高位掩码)
}
}
输出(字段位串)
返回 0
}

函数 写入位字段错误() {
输出("程序员错误：请用十进制起点:长度=十六进制值，且值须适合字段宽度")
返回 1
}

函数 写入位字段(左值) {
整数 字节数 = 参数读取(4, 程序输入, 131)
如果(字节数 > 129) { 返回 写入位字段错误() }
整数 等号 = 0
当(等号 < 字节数) {
如果(程序输入[等号] == 61) { 返回 替换位字段(左值, 等号, 字节数) }
等号 = 等号 + 1
}
返回 写入位字段错误()
}

函数 替换位字段(左值, 等号, 字节数) {
整数 范围 = 解析位字段范围(等号)
如果(范围 < 0) { 返回 写入位字段错误() }
整数 起始位 = 范围 / 64
整数 字段宽度 = 范围 - 起始位 * 64 + 1
整数 字段掩码 = 字长掩码(字段宽度)
整数 位移 = 等号 + 1
整数 值长度 = 字节数 - 位移
整数 下标 = 0
当(下标 < 值长度) {
程序输入[下标] = 程序输入[位移 + 下标]
下标 = 下标 + 1
}
整数 新字段 = 解析程序操作数(值长度, 16)
如果(程序输入错误 != 0) { 返回 写入位字段错误() }
如果(整数位与(新字段, 字段掩码) != 新字段) { 返回 写入位字段错误() }
整数 保留掩码 = 整数位反(逻辑左移(字段掩码, 起始位))
输出(整数位或(整数位与(左值, 保留掩码), 逻辑左移(新字段, 起始位)))
返回 0
}

函数 运行移位(左值, 操作) {
整数 位数 = 读取程序数(4, 10, 32)
如果(程序输入错误 == 1) {
输出("程序员错误：移位数须为非负十进制，且小于所选字长")
返回 1
}
如果(位数 >= 程序字长) {
输出("程序员错误：移位数须为非负十进制，且小于所选字长")
返回 1
}
输出(逻辑移位(左值, 操作, 位数))
返回 0
}

# 长度以微米定义比例。温度用摄氏度为中间单位，合并比例后只舍入一次。
函数 长度系数(单位) {
如果(单位 == 1) { 返回 1000 }
如果(单位 == 2) { 返回 10000 }
如果(单位 == 3) { 返回 1000000 }
如果(单位 == 4) { 返回 1000000000 }
如果(单位 == 5) { 返回 25400 }
如果(单位 == 6) { 返回 304800 }
如果(单位 == 7) { 返回 914400 }
如果(单位 == 8) { 返回 1609344000 }
返回 0
}

