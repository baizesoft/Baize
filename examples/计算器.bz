如果(全部 == 0) {
目标 = 读取程序数(2, 10, 32)
如果(程序输入错误 == 1) { 目标 = 0 }
}
整数 类别 = 单位类别(来源)
如果(类别 == 0) { 返回 换算类别错误() }
如果(类别 != 单位类别(目标)) { 返回 换算类别错误() }
倍率 = 1000000000
# 解析时限制输入为十亿量级，温度仿射变换的中间整数也能装入 64 位。
