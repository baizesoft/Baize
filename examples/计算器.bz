}

函数 日期用法() {
输出("用法：计算器 --date d/c/b YYYYMMDD YYYYMMDD 或 --date a/s YYYYMMDD 数量 [w/m/e/y/E/b] 或 年数 月数 天数，或 --date w YYYYMMDD / --date W 周年 周数 星期；工作日运算末尾可附例外列表")
返回 2
}

函数 移动日期月份(日期, 月数) {
返回 按月移动日期(日期, 月数, 0)
}

函数 按月移动日期(日期, 月数, 保持月末) {
整数 年 = 日期 / 10000
整数 月 = 日期 / 100 - 年 * 100
整数 日 = 日期 - 日期 / 100 * 100
整数 起始是月末 = 日 == 公历月天数(年, 月)
整数 月序号 = (年 - 1) * 12 + 月 - 1 + 月数
如果(月序号 < 0) { 返回 0 }
如果(月序号 >= 9999 * 12) { 返回 0 }
年 = 月序号 / 12 + 1
月 = 月序号 - (年 - 1) * 12 + 1
整数 月末 = 公历月天数(年, 月)
如果(保持月末 == 1) {
如果(起始是月末 == 1) { 日 = 月末 }
}
如果(日 > 月末) { 日 = 月末 }
返回 年 * 10000 + 月 * 100 + 日
}

函数 相隔年月日(起日, 止日) {
如果(起日 > 止日) {
整数 交换 = 起日
起日 = 止日
止日 = 交换
}
整数 起日期 = 序号转日期(起日)
整数 止日期 = 序号转日期(止日)
整数 起年月 = 起日期 / 100
整数 止年月 = 止日期 / 100
整数 月数 = (止年月 / 100 - 起年月 / 100) * 12 + (止年月 - 止年月 / 100 * 100) - (起年月 - 起年月 / 100 * 100)
整数 锚日期 = 移动日期月份(起日期, 月数)
如果(锚日期 > 止日期) {
月数 = 月数 - 1
锚日期 = 移动日期月份(起日期, 月数)
}
整数 锚年 = 锚日期 / 10000
整数 锚月 = 锚日期 / 100 - 锚年 * 100
整数 锚日 = 锚日期 - 锚日期 / 100 * 100
整数 年数 = 月数 / 12
输出(年数)
输出(月数 - 年数 * 12)
输出(止日 - 日期序号(锚年, 锚月, 锚日))
输出(止日 - 起日)
返回 0
}

函数 运行组合日期(起日, 操作) {
