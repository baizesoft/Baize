整数 左幅值 = 绝对值(解析绘图点(左试点))
如果(错误 != 0) { 返回 -9223372036854775807 }
整数 右幅值 = 绝对值(解析绘图点(右试点))
如果(错误 != 0) { 返回 -9223372036854775807 }
如果(左幅值 < 右幅值) { 右界 = 右试点 } 否则 {
如果(左幅值 > 右幅值) { 左界 = 左试点 } 否则 {
左界 = 左试点
右界 = 右试点
}
}
}
整数 候选 = 左界 + (右界 - 左界) / 2
整数 候选值 = 解析绘图点(候选)
如果(错误 == 0) {
如果(候选值 == 0) { 返回 候选 }
}
当(左界 <= 右界) {
整数 边值 = 解析绘图点(左界)
如果(错误 == 0) {
如果(边值 == 0) { 返回 左界 }
}
左界 = 左界 + 1
}
返回 -9223372036854775807
}

函数 是相切候选(左值, 中值, 右值) {
如果(左值 == 0) { 返回 0 }
如果(中值 == 0) { 返回 0 }
如果(右值 == 0) { 返回 0 }
如果((左值 < 0) != (中值 < 0)) { 返回 0 }
如果((右值 < 0) != (中值 < 0)) { 返回 0 }
整数 中幅值 = 绝对值(中值)
如果(中幅值 >= 绝对值(左值)) { 返回 0 }
返回 中幅值 <= 绝对值(右值)
}

函数 输出绘图零点(左界, 右界, 采样步数) {
整数 采样 = 0
整数 数量 = 0
整数 前点 = 左界
整数 前值 = 0
整数 更早点 = 左界
整数 更早值 = 0
整数 更早点有效 = 0
整数 前点有效 = 0
当(采样 <= 采样步数) {
整数 横坐标 = 左界 + (右界 - 左界) * 采样 / 采样步数
整数 纵坐标 = 采样绘图点(横坐标)
整数 有效 = 错误 == 0
整数 零点 = -9223372036854775807
如果(有效 == 1) {
如果(纵坐标 == 0) {
如果(前值 != 0) { 零点 = 横坐标 }
如果(前点有效 == 0) { 零点 = 横坐标 }
} 否则 {
如果(前点有效 == 1) {
如果(前值 != 0) {
如果((前值 < 0) != (纵坐标 < 0)) {
整数 取整有跳跃 = 0
如果(取整采样变化 == 1) { 取整有跳跃 = 检查取整跳跃(前点, 横坐标, 前值, 纵坐标) }
如果(取整有跳跃 == 0) { 零点 = 细化绘图零点(前点, 横坐标, 前值, 纵坐标) }
}
}
}
}
}
如果(零点 == -9223372036854775807) {
如果(有效 == 1) {
如果(前点有效 == 1) {
如果(更早点有效 == 1) {
如果(是相切候选(更早值, 前值, 纵坐标) == 1) {
零点 = 细化相切零点(更早点, 横坐标)
}
}
}
}
}
如果(零点 != -9223372036854775807) {
如果(写十进制行(零点, 1) != 0) { 返回 1 }
数量 = 数量 + 1
如果(数量 >= 16) { 返回 0 }
}
更早点 = 前点
更早值 = 前值
更早点有效 = 前点有效
前点 = 横坐标
前值 = 纵坐标
前点有效 = 有效
采样 = 采样 + 1
}
返回 0
}

