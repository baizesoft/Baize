如果(程序模式[1] != 45) { 返回 0 }
如果(程序模式[2] != 99) { 返回 0 }
如果(程序模式[3] != 111) { 返回 0 }
如果(程序模式[4] != 110) { 返回 0 }
如果(程序模式[5] != 118) { 返回 0 }
如果(程序模式[6] != 101) { 返回 0 }
如果(程序模式[7] != 114) { 返回 0 }
如果(程序模式[8] != 116) { 返回 0 }
如果(模式长度 == 9) { 返回 1 }
如果(程序模式[9] != 45) { 返回 0 }
如果(程序模式[10] != 116) { 返回 0 }
