# 统计单个 UTF-8 源文件的物理行数；无末尾换行时也计最后一行。
字节数组 路名[260]
字节数组 源码[262145]
字节数组 日志选项缓冲[16]

函数 识别日志选项(选项长度: 整数) -> 整数:
    如果 选项长度 != 10:
        返回 -1
    如果 日志选项缓冲[0] != 45:
        返回 -1
    如果 日志选项缓冲[1] != 45:
        返回 -1
    如果 日志选项缓冲[2] != 108:
        返回 -1
    如果 日志选项缓冲[3] != 111:
        返回 -1
    如果 日志选项缓冲[4] != 103:
        返回 -1
    如果 日志选项缓冲[5] != 45:
        返回 -1
    如果 日志选项缓冲[6] == 106:
        如果 日志选项缓冲[7] == 115:
            如果 日志选项缓冲[8] == 111:
                如果 日志选项缓冲[9] == 110:
                    返回 1
    如果 日志选项缓冲[6] == 116:
        如果 日志选项缓冲[7] == 101:
            如果 日志选项缓冲[8] == 120:
                如果 日志选项缓冲[9] == 116:
                    返回 0
    返回 -1

函数 统计行数(源码长度: 整数) -> 整数:
    变量 行数 = 0
    变量 下标 = 0
    当 下标 < 源码长度:
        如果 源码[下标] == 10:
            行数 = 行数 + 1
        下标 = 下标 + 1
    如果 源码长度 > 0:
        如果 源码[源码长度 - 1] != 10:
            行数 = 行数 + 1
    返回 行数

整数 参数个数 = 参数数量()
整数 日志格式 = -1
整数 日志选项长度 = 0
如果 参数个数 < 1:
    输出("用法：源码行统计 <文件.bz> [--log-text|--log-json]")
    返回 2
如果 参数个数 > 2:
    输出("用法：源码行统计 <文件.bz> [--log-text|--log-json]")
    返回 2
如果 参数个数 == 2:
    日志选项长度 = 参数读取(1, 日志选项缓冲, 16)
    日志格式 = 识别日志选项(日志选项长度)
    如果 日志格式 < 0:
        输出("错误：未知日志选项")
        返回 2
整数 路名长 = 参数读取(0, 路名, 260)
如果 路名长 < 1:
    输出("错误：文件路径不可用")
    返回 2
整数 长度 = 文件读取(路名, 源码, 262145)
如果 长度 < 0:
    输出("错误：无法读取文件")
    返回 1
如果 长度 >= 262145:
    输出("错误：文件超过统计上限")
    返回 1
整数 统计结果 = 统计行数(长度)
整数 日志路长 = 0
输出(统计结果)
如果 日志格式 >= 0:
    # 路径只有在调用者主动开启日志时才写入 stderr。
    日志路长 = 参数读取(0, 日志消息区, 1024)
    如果 日志记录(1, 日志格式, 日志路长, 统计结果) != 0:
        返回 3
