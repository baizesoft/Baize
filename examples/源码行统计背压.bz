# 八个常驻任务，主任务每次最多派发三项，闲置任务阻塞在工作通道。
# 每个文件向量至多 262144 + 8 字节（含块头），三个并存不超过 1 MiB。
整数 工作通道 = 0
整数 结果甲 = 0
整数 结果乙 = 0
整数 结果丙 = 0

函数 结果通道(序号: 整数) -> 整数:
    变量 位置 = 序号 - (序号 / 3) * 3
    如果 位置 == 0:
        返回 结果甲
    如果 位置 == 1:
        返回 结果乙
    返回 结果丙

函数 分段扫描(内容: 字节向量, 长度: 整数) -> 整数:
    变量 起 = 0
    变量 末 = 0
    变量 总数 = 0
    当 起 < 长度:
        末 = 起 + 8192
        如果 末 > 长度:
            末 = 长度
        总数 = 总数 + 统计范围(内容, 起, 末)
        起 = 末
        如果 起 < 长度:
            让出任务()
    返回 总数 + 补末行(内容, 长度)

函数 扫描文件(序号: 整数) -> 整数:
    变量 长度 = 读入文件(序号)
    如果 长度 < 0:
        返回 长度
    变量 内容 = 载入向量(长度)
    如果 向量长度(内容) != 长度:
        返回 0 - 1
    # 共享中转区已复制完，现在才允许调度到其他任务。
    返回 分段扫描(内容, 长度)

函数 工人(未用: 整数) -> 整数:
    变量 状态 = 通道接收(工作通道)
    变量 序号 = 0
    变量 结果 = 0
    当 状态 == 0:
        序号 = 通道取值()
        结果 = 扫描文件(序号)
        # 文件向量已离开根表，发送只携带整数。
        如果 通道发送(结果通道(序号), 结果) != 0:
            返回 1
        状态 = 通道接收(工作通道)
    如果 状态 == 0 - 2:
        返回 0
    返回 1

函数 关闭结果() -> 整数:
    如果 结果甲 > 0:
        关闭通道(结果甲)
    如果 结果乙 > 0:
        关闭通道(结果乙)
    如果 结果丙 > 0:
        关闭通道(结果丙)
    返回 0

函数 失败收尾(已启动: 整数, 原因: 整数) -> 整数:
    # 本程序只有这里的固定任务池，任务号按 1..已启动 分配。
    # 先取消再关通道，不恢复出错窗口里剩余的任务。
    当 已启动 > 0:
        取消任务(已启动)
        等待任务(已启动)
        已启动 = 已启动 - 1
    如果 工作通道 > 0:
        关闭通道(工作通道)
    关闭结果()
    返回 报告文件错误(原因)

函数 处理窗口(起: 整数, 末: 整数) -> 整数:
    变量 序号 = 起
    变量 结果 = 0
    当 序号 < 末:
        如果 通道发送(工作通道, 序号) != 0:
            返回 0 - 4
        序号 = 序号 + 1
    序号 = 起
    当 序号 < 末:
        如果 通道接收(结果通道(序号)) != 0:
            返回 0 - 4
        结果 = 通道取值()
        如果 结果 < 0:
            返回 结果
        输出(结果)
        序号 = 序号 + 1
    返回 0

函数 批量背压(个数: 整数) -> 整数:
    工作通道 = 新建整数通道(3)
    结果甲 = 新建整数通道(1)
    结果乙 = 新建整数通道(1)
    结果丙 = 新建整数通道(1)
    如果 工作通道 <= 0:
        返回 失败收尾(0, 0 - 4)
    如果 结果甲 <= 0:
        返回 失败收尾(0, 0 - 4)
    如果 结果乙 <= 0:
        返回 失败收尾(0, 0 - 4)
    如果 结果丙 <= 0:
        返回 失败收尾(0, 0 - 4)
    变量 已启动 = 0
    当 已启动 < 8:
        如果 启动任务(工人, 0) <= 0:
            返回 失败收尾(已启动, 0 - 4)
        已启动 = 已启动 + 1
    变量 起 = 0
    变量 末 = 0
    变量 结果 = 0
    当 起 < 个数:
        末 = 起 + 3
        如果 末 > 个数:
            末 = 个数
        结果 = 处理窗口(起, 末)
        如果 结果 < 0:
            返回 失败收尾(已启动, 结果)
        起 = 末
    关闭通道(工作通道)
    变量 序号 = 1
    当 序号 <= 已启动:
        如果 等待任务(序号) != 0:
            返回 失败收尾(已启动, 0 - 4)
        序号 = 序号 + 1
    关闭结果()
    返回 0

如果 参数数量() < 1:
    输出("用法：批量源码行统计 <文件.bz> ...")
    返回 2
返回 批量背压(参数数量())
